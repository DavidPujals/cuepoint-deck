<UserControl x:Class="CuepointDeck.App.Views.EditView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:app="clr-namespace:CuepointDeck.App"
             xmlns:ctl="clr-namespace:CuepointDeck.App.Controls"
             xmlns:vm="clr-namespace:CuepointDeck.App.ViewModels"
             x:Name="Root" Focusable="False">
    <UserControl.Resources>
        <app:HexToBrushConverter x:Key="Hex"/>
        <app:BoolToVisibilityConverter x:Key="Vis"/>
        <app:BoolToVisibilityConverter x:Key="VisInv" Invert="True"/>
        <app:NullToVisibilityConverter x:Key="NotNullVis"/>
        <app:NullToVisibilityConverter x:Key="NullVis" Invert="True"/>
        <app:CountToVisibilityConverter x:Key="AnyVis"/>
        <app:CountToVisibilityConverter x:Key="NoneVis" Invert="True"/>
        <app:ImageAspectConverter x:Key="Aspect"/>
        <app:MinusConverter x:Key="Minus"/>
        <app:LessThanConverter x:Key="LessThan"/>
        <app:SameTextMultiConverter x:Key="SameText"/>

        <Style x:Key="TimeBox" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="FontFamily" Value="{StaticResource DisplayFont}"/>
            <Setter Property="Typography.NumeralAlignment" Value="Tabular"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Width" Value="116"/>
            <Setter Property="app:Ui.CommitOnEnter" Value="True"/>
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="Margin" Value="0,0,12,0"/>
        </Style>
        <!-- the bar under a list: + − (and reorder) like a Mac list -->
        <Style x:Key="ListBar" TargetType="Border">
            <Setter Property="BorderBrush" Value="{StaticResource SeparatorBrush}"/>
            <Setter Property="BorderThickness" Value="0,1,0,0"/>
            <Setter Property="Padding" Value="8,6"/>
        </Style>
        <Style x:Key="BarGlyph" TargetType="Button" BasedOn="{StaticResource GlyphButton}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Margin" Value="0,0,2,0"/>
        </Style>
    </UserControl.Resources>

    <!-- The page is always exactly the window: nothing is ever reached by scrolling the page. As the window narrows the
         panels share the width, the sidebar tucks away behind the toolbar's sidebar button (and slides over the content
         when opened), and as it gets shorter the inspector and the preview give up space first, scrolling inside
         themselves only at the very smallest sizes. -->
    <Grid x:Name="PageGrid">
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="SidebarColumn" Width="248"/>
            <ColumnDefinition x:Name="GapColumn" Width="12"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ================================================================== sidebar: songs and setlists -->
        <Border x:Name="Sidebar" Grid.Column="0" Panel.ZIndex="10" Background="{StaticResource SidebarBrush}" BorderBrush="{StaticResource SeparatorBrush}" BorderThickness="1" CornerRadius="10">
            <DockPanel>
                <TextBox DockPanel.Dock="Top" Style="{StaticResource SearchBox}" app:Ui.Placeholder="Search Songs" Margin="10,10,10,6"
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"/>

                <!-- bottom bar: + (new song or setlist) and ⋯ -->
                <Border DockPanel.Dock="Bottom" Style="{StaticResource ListBar}">
                    <DockPanel>
                        <Button x:Name="AddMenuButton" DockPanel.Dock="Left" Style="{StaticResource IconButton}" app:Ui.Icon="&#xE710;" app:Ui.DropDownMenu="True" ToolTip="New song or setlist">
                            <Button.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="New Song from Resolume…" Command="{Binding NewFromCompositionCommand}"/>
                                    <MenuItem Header="New Song from File…" Command="{Binding NewFromFileCommand}"/>
                                    <Separator/>
                                    <MenuItem Header="New Setlist…" Command="{Binding NewSetlistCommand}"/>
                                    <Separator/>
                                    <MenuItem Header="Import Songs…" Command="{Binding ImportSongsCommand}"/>
                                    <MenuItem Header="Export Songs…" Command="{Binding ExportSongsCommand}"/>
                                </ContextMenu>
                            </Button.ContextMenu>
                        </Button>
                        <Button DockPanel.Dock="Left" Style="{StaticResource IconButton}" app:Ui.Icon="&#xE8B7;" ToolTip="Show the library folder in Explorer" Command="{Binding OpenLibraryFolderCommand}"/>
                        <TextBlock Text="{Binding SongCount, StringFormat={}{0} songs}" Style="{StaticResource CaptionText}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    </DockPanel>
                </Border>

                <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False" Padding="6,4,6,8">
                    <StackPanel>
                        <TextBlock Text="Songs" Style="{StaticResource SectionHeader}" Margin="6,6,0,4"/>
                        <ListBox Style="{StaticResource SidebarList}" ItemsSource="{Binding Songs}" SelectedItem="{Binding SelectedSongItem}"
                                 Tag="{Binding DataContext, ElementName=Root}">
                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:SongListItem}">
                                    <StackPanel Margin="2,0" Background="Transparent" Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=ListBox}}">
                                        <StackPanel.ContextMenu>
                                            <ContextMenu>
                                                <MenuItem Header="Export Song…" Command="{Binding PlacementTarget.Tag.ExportSongCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}"/>
                                                <Separator/>
                                                <MenuItem Header="Delete Song…" Style="{StaticResource DestructiveMenuItem}"
                                                          Command="{Binding PlacementTarget.Tag.DeleteSongCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}"/>
                                            </ContextMenu>
                                        </StackPanel.ContextMenu>
                                        <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding Detail}" FontSize="11" Opacity="0.7" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <TextBlock Style="{StaticResource CaptionText}" Margin="8,2,8,0" TextWrapping="Wrap" Visibility="{Binding Songs.Count, Converter={StaticResource NoneVis}}"
                                   Text="No songs here yet. Use + to add one from Resolume or a file."/>

                        <TextBlock Text="Setlists" Style="{StaticResource SectionHeader}" Margin="6,18,0,4"/>
                        <ListBox Style="{StaticResource SidebarList}" ItemsSource="{Binding Setlists.Names}" SelectedItem="{Binding SelectedSetlistName}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel Margin="2,1" Background="Transparent" Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=ListBox}}">
                                        <DockPanel.ContextMenu>
                                            <ContextMenu>
                                                <MenuItem Header="Use in Show Mode" Command="{Binding PlacementTarget.Tag.UseSetlistInShowCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}"/>
                                                <Separator/>
                                                <MenuItem Header="Rename…" Command="{Binding PlacementTarget.Tag.RenameSetlistCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}"/>
                                                <MenuItem Header="Duplicate…" Command="{Binding PlacementTarget.Tag.DuplicateSetlistCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}"/>
                                                <Separator/>
                                                <MenuItem Header="Delete Setlist…" Style="{StaticResource DestructiveMenuItem}" Command="{Binding PlacementTarget.Tag.DeleteSetlistCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}"/>
                                            </ContextMenu>
                                        </DockPanel.ContextMenu>
                                        <TextBlock DockPanel.Dock="Left" Text="&#xE8FD;" Style="{StaticResource SymbolText}" FontSize="12" Opacity="0.75" Margin="0,0,8,0"/>
                                        <Border x:Name="OnShow" DockPanel.Dock="Right" Style="{StaticResource Badge}" Padding="7,0" Background="#1D3326" Visibility="Collapsed">
                                            <TextBlock Text="On Show" FontSize="10.5" Foreground="{StaticResource AccentBrush}"/>
                                        </Border>
                                        <TextBlock Text="{Binding}" FontSize="13" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                    </DockPanel>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Value="True">
                                            <DataTrigger.Binding>
                                                <MultiBinding Converter="{StaticResource SameText}">
                                                    <Binding/>
                                                    <Binding Path="DataContext.Setlists.ActiveName" RelativeSource="{RelativeSource AncestorType=UserControl}"/>
                                                </MultiBinding>
                                            </DataTrigger.Binding>
                                            <Setter TargetName="OnShow" Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <TextBlock Style="{StaticResource CaptionText}" Margin="8,2,8,0" TextWrapping="Wrap" Visibility="{Binding Setlists.Names.Count, Converter={StaticResource NoneVis}}"
                                   Text="No setlists yet. Use + to make one."/>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- ================================================================== nothing selected -->
        <StackPanel Grid.Column="2" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="440" Visibility="{Binding IsEmptyView, Converter={StaticResource Vis}}">
            <TextBlock Text="&#xE70F;" Style="{StaticResource SymbolText}" FontSize="40" Foreground="{StaticResource TertiaryBrush}" HorizontalAlignment="Center"/>
            <TextBlock Text="Choose a Song or a Setlist" Style="{StaticResource TitleText}" HorizontalAlignment="Center" Margin="0,14,0,0"/>
            <TextBlock Style="{StaticResource SecondaryText}" FontSize="13" TextAlignment="Center" Margin="0,6,0,0"
                       Text="Pick one in the sidebar, or start a new song from a Resolume column or a media file. Nothing you do here is sent to Resolume."/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,18,0,0">
                <Button Content="New Song from Resolume…" Style="{StaticResource PrimaryButton}" Command="{Binding NewFromCompositionCommand}"/>
                <Button Content="New Song from File…" Margin="8,0,0,0" Command="{Binding NewFromFileCommand}"/>
            </StackPanel>
        </StackPanel>

        <!-- ================================================================== song editor -->
        <Grid Grid.Column="2" Visibility="{Binding IsSongView, Converter={StaticResource Vis}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*" MinWidth="320"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="2*" MinWidth="280" MaxWidth="400"/>
            </Grid.ColumnDefinitions>

            <DockPanel x:Name="EditorColumn" Grid.Column="0">
                <!-- header: the title edits in place; Save is the one prominent action and only lights up when there is something to save -->
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top" Margin="12,2,0,0">
                        <TextBlock Text="{Binding SaveStatusText}" Style="{StaticResource CaptionText}" FontSize="12" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <Button Content="Save" Style="{StaticResource PrimaryButton}" MinWidth="84" IsEnabled="{Binding IsDirty}" Command="{Binding SaveCommand}" ToolTip="Save the song (Ctrl+S)"/>
                        <Button x:Name="MoreMenuButton" Style="{StaticResource IconButton}" app:Ui.Icon="&#xE712;" app:Ui.DropDownMenu="True" Margin="4,0,0,0" ToolTip="More">
                            <Button.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="Link to Column…" Command="{Binding LinkToColumnCommand}"/>
                                    <MenuItem Header="Render Missing Thumbnails" Command="{Binding RenderThumbnailsCommand}"/>
                                    <Separator/>
                                    <MenuItem Header="Export Song…" Command="{Binding ExportSongsCommand}" IsEnabled="{Binding CanDeleteSong}"/>
                                    <MenuItem Header="Show Library Folder" Command="{Binding OpenLibraryFolderCommand}"/>
                                    <Separator/>
                                    <MenuItem Header="Delete Song…" Style="{StaticResource DestructiveMenuItem}" Command="{Binding DeleteSongCommand}" IsEnabled="{Binding CanDeleteSong}"/>
                                </ContextMenu>
                            </Button.ContextMenu>
                        </Button>
                    </StackPanel>
                    <StackPanel>
                        <TextBox Style="{StaticResource InlineTextBox}" Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}" FontFamily="{StaticResource DisplayFont}" FontSize="24" FontWeight="SemiBold"
                                 app:Ui.Placeholder="Song title" Margin="-4,0,0,0"/>
                        <DockPanel Margin="0,2,0,0">
                            <TextBox DockPanel.Dock="Left" Style="{StaticResource InlineTextBox}" Text="{Binding Artist, UpdateSourceTrigger=PropertyChanged}" FontSize="13" Foreground="{StaticResource MutedBrush}"
                                     app:Ui.Placeholder="Add an artist" MinWidth="120" Margin="-4,0,10,0"/>
                            <TextBlock Style="{StaticResource CaptionText}" FontSize="12" VerticalAlignment="Center" ToolTip="{Binding ClipFileText}">
                                <Run Text="{Binding ClipStatusText, Mode=OneWay}"/><Run Text="  ·  "/><Run Text="{Binding DurationText, Mode=OneWay}"/>
                            </TextBlock>
                        </DockPanel>
                    </StackPanel>
                </DockPanel>

                <!-- inspector for the selected segment: always on screen; on short windows it gives way to a usable
                     segment list and scrolls inside itself -->
                <ScrollViewer DockPanel.Dock="Bottom" Margin="0,10,0,0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False"
                              MaxHeight="{Binding ActualHeight, ElementName=EditorColumn, Converter={StaticResource Minus}, ConverterParameter='300,56'}"
                              Visibility="{Binding SelectedSegment, Converter={StaticResource NotNullVis}}">
                <Border Style="{StaticResource InsetGroup}" Padding="16,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="72"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="Name" Style="{StaticResource FieldLabel}"/>
                        <ComboBox Grid.Row="0" Grid.Column="1" Style="{StaticResource EditableCombo}" Width="240" HorizontalAlignment="Left" Margin="0,0,0,8"
                                  ItemsSource="{Binding QuickNamesList}" Text="{Binding SelectedSegment.Name, UpdateSourceTrigger=PropertyChanged}"
                                  ToolTip="Type any name (Bridge 2, Big Chorus), or pick one of the usual ones from the list"/>

                        <TextBlock Grid.Row="1" Text="Starts" Style="{StaticResource FieldLabel}" VerticalAlignment="Top" Margin="0,6,12,0"/>
                        <WrapPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,4">
                            <TextBox Style="{StaticResource TimeBox}" Text="{Binding SelectedSegment.StartText}" Margin="0,0,0,4" ToolTip="hh:mm:ss:ff at the clip's frame rate. Return to apply."/>
                            <Button Style="{StaticResource GlyphButton}" Content="&#xE738;" Margin="6,0,0,4" Command="{Binding NudgeCommand}" CommandParameter="-frame" ToolTip="One frame earlier (Shift: five)"/>
                            <Button Style="{StaticResource GlyphButton}" Content="&#xE710;" Margin="2,0,0,0" Command="{Binding NudgeCommand}" CommandParameter="+frame" ToolTip="One frame later (Shift: five)"/>
                            <Button Content="Set Start" Margin="8,0,0,4" app:Ui.DropDownMenu="True" Padding="12,4">
                                <Button.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="To Resolume's Playhead" Command="{Binding SetStartFromPlayheadCommand}" IsEnabled="{Binding PlayheadAvailable}"/>
                                        <MenuItem Header="To the Preview Position" Command="{Binding SetStartFromScrubberCommand}"/>
                                        <Separator/>
                                        <MenuItem Header="Show Start in Preview" Command="{Binding SeekScrubberToSegmentCommand}"/>
                                    </ContextMenu>
                                </Button.ContextMenu>
                            </Button>
                        </WrapPanel>

                        <TextBlock Grid.Row="2" Text="Ends" Style="{StaticResource FieldLabel}" VerticalAlignment="Top" Margin="0,6,12,0"/>
                        <WrapPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,4">
                            <CheckBox Content="Early" IsChecked="{Binding SelectedSegment.EndsEarly}" Margin="0,7,10,11"
                                      ToolTip="Give the segment its own end, leaving a gap before the next one that belongs to no segment"/>
                            <WrapPanel Orientation="Horizontal" Margin="0,0,0,4" Visibility="{Binding SelectedSegment.EndsEarly, Converter={StaticResource Vis}}">
                                <TextBox Style="{StaticResource TimeBox}" Text="{Binding SelectedSegment.EndText}"/>
                                <Button Style="{StaticResource GlyphButton}" Content="&#xE738;" Margin="6,0,0,0" Command="{Binding NudgeEndCommand}" CommandParameter="-frame" ToolTip="One frame earlier (Shift: five)"/>
                                <Button Style="{StaticResource GlyphButton}" Content="&#xE710;" Margin="2,0,0,0" Command="{Binding NudgeEndCommand}" CommandParameter="+frame" ToolTip="One frame later (Shift: five)"/>
                                <Button Content="Set End" Margin="8,0,0,0" app:Ui.DropDownMenu="True" Padding="12,4">
                                    <Button.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="To Resolume's Playhead" Command="{Binding SetEndFromPlayheadCommand}" IsEnabled="{Binding PlayheadAvailable}"/>
                                            <MenuItem Header="To the Preview Position" Command="{Binding SetEndFromScrubberCommand}"/>
                                            <Separator/>
                                            <MenuItem Header="Show End in Preview" Command="{Binding SeekScrubberToEndCommand}"/>
                                        </ContextMenu>
                                    </Button.ContextMenu>
                                </Button>
                            </WrapPanel>
                            <TextBlock Text="Runs until the next segment starts" Style="{StaticResource CaptionText}" FontSize="12" VerticalAlignment="Top" Margin="0,8,0,8"
                                       Visibility="{Binding SelectedSegment.EndsEarly, Converter={StaticResource VisInv}}"/>
                        </WrapPanel>

                        <TextBlock Grid.Row="3" Text="Lyric" Style="{StaticResource FieldLabel}"/>
                        <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding SelectedSegment.Lyric, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8"
                                 app:Ui.Placeholder="A line to recognise it by on the card"/>

                        <TextBlock Grid.Row="4" Text="Colour" Style="{StaticResource FieldLabel}"/>
                        <ItemsControl Grid.Row="4" Grid.Column="1" ItemsSource="{Binding PaletteList}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><WrapPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Width="24" Height="24" MinHeight="0" Padding="0" Margin="0,0,7,4" Cursor="Hand"
                                            Command="{Binding DataContext.SetColorCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" ToolTip="{Binding}">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Grid>
                                                    <Ellipse x:Name="Ring" Stroke="White" StrokeThickness="2" Visibility="Collapsed"/>
                                                    <Ellipse Fill="{Binding Converter={StaticResource Hex}}" Margin="4"/>
                                                </Grid>
                                                <ControlTemplate.Triggers>
                                                    <DataTrigger Value="True">
                                                        <DataTrigger.Binding>
                                                            <MultiBinding Converter="{StaticResource SameText}">
                                                                <Binding/>
                                                                <Binding Path="DataContext.SelectedSegment.Color" RelativeSource="{RelativeSource AncestorType=UserControl}"/>
                                                            </MultiBinding>
                                                        </DataTrigger.Binding>
                                                        <Setter TargetName="Ring" Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>
                </Border>
                </ScrollViewer>

                <!-- segments -->
                <Border x:Name="SegmentsGroup" Style="{StaticResource InsetGroup}" Padding="0">
                    <DockPanel>
                        <!-- the add buttons sit beside the title; on a narrow panel they step aside and the list's + menu has them all -->
                        <Grid DockPanel.Dock="Top" Margin="16,12,12,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <WrapPanel.Style>
                                    <Style TargetType="WrapPanel">
                                        <Setter Property="Grid.Column" Value="1"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ActualWidth, ElementName=SegmentsGroup, Converter={StaticResource LessThan}, ConverterParameter=380}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </WrapPanel.Style>
                                <Button Content="Add at Playhead" Style="{StaticResource PrimaryButton}" Margin="0,0,0,4" Command="{Binding MarkAtPlayheadCommand}" IsEnabled="{Binding PlayheadAvailable}"
                                        ToolTip="Add a segment where Resolume's playhead is now (M). Start the clip in Resolume to mark by ear."/>
                                <Button Content="Add at Preview" Margin="6,0,0,4" Command="{Binding MarkAtScrubberCommand}" IsEnabled="{Binding ScrubberAvailable}"
                                        ToolTip="Add a segment at the preview position (Shift+M)">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ActualWidth, ElementName=SegmentsGroup, Converter={StaticResource LessThan}, ConverterParameter=620}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                                <Button Margin="6,0,0,4" app:Ui.DropDownMenu="True" Padding="10,4" ToolTip="Fill in segments and lyric notes automatically, on this PC">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE945;" Style="{StaticResource SymbolText}" FontSize="12"/>
                                        <TextBlock Text="Auto" Margin="6,0,0,0"/>
                                        <TextBlock Text="&#xE70D;" Style="{StaticResource SymbolText}" FontSize="9" Margin="6,1,0,0" Foreground="{StaticResource MutedBrush}"/>
                                    </StackPanel>
                                    <Button.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="Suggest Segments…" Command="{Binding SuggestSegmentsCommand}"/>
                                            <MenuItem Header="Read Lyric Notes from the Video" Command="{Binding ReadLyricsFromVideoCommand}"/>
                                        </ContextMenu>
                                    </Button.ContextMenu>
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ActualWidth, ElementName=SegmentsGroup, Converter={StaticResource LessThan}, ConverterParameter=620}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </WrapPanel>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,10,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Segments" Style="{StaticResource HeadlineText}"/>
                                    <TextBlock Text="{Binding SegmentCountText}" Style="{StaticResource CaptionText}" FontSize="13" Margin="8,0,0,0"/>
                                </StackPanel>
                                <TextBlock Style="{StaticResource CaptionText}" FontSize="12" Margin="0,2,0,0">
                                    <Run Text="Resolume"/>
                                    <Run Text="{Binding PlayheadText, Mode=OneWay}" FontWeight="SemiBold" Foreground="{StaticResource InkBrush}" Typography.NumeralAlignment="Tabular"/>
                                    <Run Text="{Binding PlayheadHint, Mode=OneWay}"/>
                                </TextBlock>
                            </StackPanel>
                        </Grid>

                        <!-- suggestion progress and the keep/discard choice -->
                        <Border DockPanel.Dock="Top" Background="#17283D" BorderBrush="#24456B" BorderThickness="1" CornerRadius="8" Margin="12,0,12,8" Padding="12,8"
                                Visibility="{Binding SuggestStatus, Converter={StaticResource NotNullVis}}">
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" Visibility="{Binding HasDrafts, Converter={StaticResource Vis}}">
                                        <Button Content="Discard Drafts" Style="{StaticResource DangerButton}" Command="{Binding DiscardDraftsCommand}"/>
                                        <Button Content="Keep Drafts" Style="{StaticResource PrimaryButton}" Margin="6,0,0,0" Command="{Binding AcceptDraftsCommand}"/>
                                    </StackPanel>
                                    <Button Style="{StaticResource IconButton}" app:Ui.Icon="&#xE711;" ToolTip="Dismiss" Command="{Binding DismissSuggestStatusCommand}"
                                            Visibility="{Binding HasDrafts, Converter={StaticResource VisInv}}"/>
                                </StackPanel>
                                <TextBlock Text="&#xE945;" DockPanel.Dock="Left" Style="{StaticResource SymbolText}" FontSize="13" Foreground="{StaticResource TintTextBrush}" Margin="0,0,10,0" VerticalAlignment="Top"/>
                                <TextBlock Text="{Binding SuggestStatus}" FontSize="12.5" TextWrapping="Wrap" VerticalAlignment="Center"/>
                            </DockPanel>
                        </Border>

                        <Border DockPanel.Dock="Bottom" Style="{StaticResource ListBar}">
                            <DockPanel>
                                <Button x:Name="AddSegmentMenuButton" DockPanel.Dock="Left" Style="{StaticResource BarGlyph}" Content="&#xE710;" app:Ui.DropDownMenu="True" ToolTip="Add segments">
                                    <Button.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="Add at Resolume's Playhead" InputGestureText="M" Command="{Binding MarkAtPlayheadCommand}" IsEnabled="{Binding PlayheadAvailable}"/>
                                            <MenuItem Header="Add at the Preview Position" InputGestureText="Shift+M" Command="{Binding MarkAtScrubberCommand}" IsEnabled="{Binding ScrubberAvailable}"/>
                                            <Separator/>
                                            <MenuItem Header="Suggest Segments…" Command="{Binding SuggestSegmentsCommand}"/>
                                            <MenuItem Header="Read Lyric Notes from the Video" Command="{Binding ReadLyricsFromVideoCommand}"/>
                                        </ContextMenu>
                                    </Button.ContextMenu>
                                </Button>
                                <Button DockPanel.Dock="Left" Style="{StaticResource BarGlyph}" Content="&#xE738;" Command="{Binding DeleteSegmentCommand}" ToolTip="Delete the selected segment (Delete). Ctrl+Z brings it back."/>
                                <TextBlock Text="Delete removes a segment; Ctrl+Z brings it back. Nothing is saved until you press Save." Style="{StaticResource CaptionText}" VerticalAlignment="Center" Margin="10,0,0,0"
                                           ToolTip="Delete removes a segment; Ctrl+Z brings it back. Nothing is saved until you press Save."/>
                            </DockPanel>
                        </Border>

                        <Grid>
                            <ListBox x:Name="SegmentList" ItemsSource="{Binding Segments}" SelectedItem="{Binding SelectedSegment}" Background="Transparent" BorderThickness="0" Padding="8,0,8,4"
                                     HorizontalContentAlignment="Stretch" Tag="{Binding DataContext, ElementName=Root}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:SegmentEditItem}">
                                        <Grid Margin="0,2" Background="Transparent" Tag="{Binding Tag, RelativeSource={RelativeSource AncestorType=ListBox}}">
                                            <Grid.ContextMenu>
                                                <ContextMenu>
                                                    <MenuItem Header="Show in Preview" Command="{Binding PlacementTarget.Tag.SeekScrubberToSegmentCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                                    <MenuItem Header="Set Start to Resolume's Playhead" Command="{Binding PlacementTarget.Tag.SetStartFromPlayheadCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                                    <MenuItem Header="Set Start to the Preview Position" Command="{Binding PlacementTarget.Tag.SetStartFromScrubberCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                                    <Separator/>
                                                    <MenuItem Header="Delete Segment" InputGestureText="Delete" Style="{StaticResource DestructiveMenuItem}" Command="{Binding PlacementTarget.Tag.DeleteSegmentCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                                </ContextMenu>
                                            </Grid.ContextMenu>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="12"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <ctl:AspectBox Grid.Column="0" MaxHeight="50" MaxWidth="190" Ratio="{Binding Thumb, Converter={StaticResource Aspect}}" VerticalAlignment="Center">
                                                <Border CornerRadius="5" ClipToBounds="True" Background="{Binding Color, Converter={StaticResource Hex}, ConverterParameter=0.55}">
                                                    <Image Source="{Binding Thumb}" Stretch="Uniform" Visibility="{Binding Thumb, Converter={StaticResource NotNullVis}}"/>
                                                </Border>
                                            </ctl:AspectBox>
                                            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                                <DockPanel>
                                                    <TextBlock DockPanel.Dock="Right" Text="{Binding RangeText}" FontSize="12.5" Opacity="0.75" Typography.NumeralAlignment="Tabular" Margin="10,0,0,0"/>
                                                    <Ellipse DockPanel.Dock="Left" Width="9" Height="9" Fill="{Binding Color, Converter={StaticResource Hex}}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                    <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                                </DockPanel>
                                                <TextBlock Text="{Binding Lyric}" FontSize="12" Opacity="0.7" TextTrimming="CharacterEllipsis" Margin="17,1,0,0" Visibility="{Binding Lyric, Converter={StaticResource NotNullVis}}"/>
                                                <TextBlock Text="{Binding DraftText}" FontSize="11" FontStyle="Italic" Foreground="{StaticResource TintTextBrush}" Margin="17,1,0,0" Visibility="{Binding IsDraft, Converter={StaticResource Vis}}"/>
                                                <TextBlock Text="{Binding ThumbStatus}" FontSize="11" Opacity="0.6" Margin="17,1,0,0" Visibility="{Binding ThumbStatus, Converter={StaticResource NotNullVis}}"/>
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="380" Visibility="{Binding Segments.Count, Converter={StaticResource NoneVis}}">
                                <TextBlock Text="No Segments Yet" Style="{StaticResource HeadlineText}" HorizontalAlignment="Center"/>
                                <TextBlock Style="{StaticResource SecondaryText}" TextAlignment="Center" Margin="0,4,0,0"
                                           Text="Play the clip in Resolume and press M at each section, step through the preview and press Shift+M, or let Auto suggest them."/>
                            </StackPanel>
                        </Grid>
                    </DockPanel>
                </Border>
            </DockPanel>

            <!-- ================================================================== preview -->
            <Border Grid.Column="2" Style="{StaticResource InsetGroup}" Padding="14,12">
                <DockPanel x:Name="PreviewColumn">
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                        <TextBlock DockPanel.Dock="Right" Text="{Binding PreviewKind}" Style="{StaticResource CaptionText}" VerticalAlignment="Center"/>
                        <TextBlock Text="Preview" Style="{StaticResource HeadlineText}"/>
                    </DockPanel>
                    <!-- height follows the clip's shape: a 16:9 song is 16:9 here, a 2688x512 canvas is a wide strip -->
                    <Border DockPanel.Dock="Top" Background="Black" CornerRadius="8" ClipToBounds="True" HorizontalAlignment="Center"
                            MaxHeight="{Binding ActualHeight, ElementName=PreviewColumn, Converter={StaticResource Minus}, ConverterParameter='200,60'}">
                        <ctl:AspectBox Ratio="{Binding PreviewAspect}">
                            <Grid>
                                <Image Source="{Binding PreviewImage}" Stretch="Uniform" Visibility="{Binding ProxyPath, Converter={StaticResource NullVis}}"/>
                                <MediaElement x:Name="Player" LoadedBehavior="Manual" UnloadedBehavior="Manual" ScrubbingEnabled="True" Stretch="Uniform"
                                              Visibility="{Binding ProxyPath, Converter={StaticResource NotNullVis}}"
                                              MediaOpened="Player_MediaOpened" MediaEnded="Player_MediaEnded" MediaFailed="Player_MediaFailed"
                                              MouseLeftButtonUp="Player_MouseLeftButtonUp"/>
                            </Grid>
                        </ctl:AspectBox>
                    </Border>
                    <TextBlock DockPanel.Dock="Top" Text="{Binding SourceFileStatus}" Margin="2,6,2,0" TextWrapping="Wrap" MaxHeight="32"
                               ToolTip="{Binding SourceFileStatus}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource CaptionText}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SourceFileMissing}" Value="True">
                                        <Setter Property="Foreground" Value="{StaticResource WarnBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <!-- transport: the timecode over the buttons, so it fits the narrowest preview -->
                    <Grid DockPanel.Dock="Top" Margin="0,8,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="{Binding ScrubText}" Style="{StaticResource TimecodeText}" FontSize="22" HorizontalAlignment="Center"/>
                        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,6,0,0">
                            <Button Style="{StaticResource GlyphButton}" Content="&#xE76B;" Height="32" Width="34" Click="StepBack_Click" ToolTip="Previous frame (←, Shift: one second)"/>
                            <Button Style="{StaticResource PrimaryButton}" Margin="6,0" MinWidth="92" Command="{Binding PlayPauseCommand}" ToolTip="Space">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock FontSize="12" Foreground="White">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource SymbolText}">
                                                <Setter Property="Text" Value="&#xE768;"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsPlaying}" Value="True"><Setter Property="Text" Value="&#xE769;"/></DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBlock Text="{Binding PlayPauseText}" Foreground="White" Margin="7,0,0,0"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource GlyphButton}" Content="&#xE76C;" Height="32" Width="34" Click="StepForward_Click" ToolTip="Next frame (→, Shift: one second)"/>
                        </StackPanel>
                    </Grid>
                    <Slider DockPanel.Dock="Top" x:Name="ScrubSlider" Minimum="0" Maximum="{Binding DurationMs}" Value="{Binding ScrubMs}" IsMoveToPointEnabled="True"
                            SmallChange="{Binding FrameStepMs}" LargeChange="1000" Margin="0,8,0,0" PreviewKeyDown="ScrubSlider_PreviewKeyDown" IsEnabled="{Binding ScrubberAvailable}"
                            Thumb.DragStarted="ScrubSlider_DragStarted"/>
                    <TextBlock DockPanel.Dock="Top" Text="{Binding ScrubStatus}" Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="2,4,2,0" Visibility="{Binding ScrubStatus, Converter={StaticResource NotNullVis}}"/>

                    <TextBlock DockPanel.Dock="Top" Text="Every 2 Seconds" Style="{StaticResource SectionHeader}" Margin="2,14,0,6" Visibility="{Binding Frames.Count, Converter={StaticResource AnyVis}}"/>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
                        <ItemsControl ItemsSource="{Binding Frames}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:FilmstripFrame}">
                                    <ctl:AspectBox Height="52" Margin="2" Cursor="Hand" Ratio="{Binding Image, Converter={StaticResource Aspect}}" MouseLeftButtonDown="Frame_MouseLeftButtonDown" ToolTip="{Binding TimeText}">
                                        <Border CornerRadius="4" ClipToBounds="True">
                                            <Grid>
                                                <Image Source="{Binding Image}" Stretch="Uniform"/>
                                                <Border Background="#B3000000" CornerRadius="3" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="2" Padding="3,0">
                                                    <TextBlock Text="{Binding TimeText}" FontSize="9" Foreground="White" Typography.NumeralAlignment="Tabular"/>
                                                </Border>
                                            </Grid>
                                        </Border>
                                    </ctl:AspectBox>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>

        <!-- ================================================================== setlist editor -->
        <DockPanel Grid.Column="2" DataContext="{Binding Setlists}" Visibility="{Binding DataContext.IsSetlistView, ElementName=Root, Converter={StaticResource Vis}}">
            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Style="{StaticResource Badge}" Background="#1D3326" Padding="10,4" Visibility="{Binding IsActive, Converter={StaticResource Vis}}" ToolTip="This is the setlist in Show mode's toolbar">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE73E;" Style="{StaticResource SymbolText}" FontSize="11" Foreground="{StaticResource AccentBrush}"/>
                            <TextBlock Text="On Show" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold" FontSize="12" Margin="6,0,0,0"/>
                        </StackPanel>
                    </Border>
                    <Button Content="Use in Show Mode" Style="{StaticResource PrimaryButton}" Command="{Binding UseInShowCommand}" Visibility="{Binding IsActive, Converter={StaticResource VisInv}}"/>
                    <Button Style="{StaticResource IconButton}" app:Ui.Icon="&#xE712;" app:Ui.DropDownMenu="True" Margin="6,0,0,0" ToolTip="More"
                            DataContext="{Binding DataContext, ElementName=Root}">
                        <Button.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Rename…" Command="{Binding RenameSetlistCommand}"/>
                                <MenuItem Header="Duplicate…" Command="{Binding DuplicateSetlistCommand}"/>
                                <Separator/>
                                <MenuItem Header="Delete Setlist…" Style="{StaticResource DestructiveMenuItem}" Command="{Binding DeleteSetlistCommand}"/>
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="{Binding SelectedName}" Style="{StaticResource LargeTitleText}" FontSize="24"/>
                    <TextBlock Style="{StaticResource CaptionText}" FontSize="12" Margin="0,2,0,0">
                        <Run Text="{Binding Summary, Mode=OneWay}"/><Run Text="  ·  "/><Run Text="Changes save automatically"/>
                    </TextBlock>
                </StackPanel>
            </DockPanel>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="260"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*" MinWidth="220" MaxWidth="340"/>
                </Grid.ColumnDefinitions>

                <!-- running order -->
                <Border Grid.Column="0" Style="{StaticResource InsetGroup}" Padding="0">
                    <DockPanel>
                        <DockPanel DockPanel.Dock="Top" Margin="16,12,16,8">
                            <TextBlock Text="Drag to reorder" Style="{StaticResource CaptionText}" DockPanel.Dock="Right" VerticalAlignment="Center"/>
                            <TextBlock Text="Running Order" Style="{StaticResource HeadlineText}"/>
                        </DockPanel>
                        <Border DockPanel.Dock="Bottom" Style="{StaticResource ListBar}">
                            <StackPanel Orientation="Horizontal">
                                <Button Style="{StaticResource BarGlyph}" Content="&#xE738;" Command="{Binding RemoveSongCommand}" ToolTip="Remove from this setlist (Delete). The song stays in the library."/>
                                <Rectangle Width="1" Fill="{StaticResource SeparatorBrush}" Margin="6,4"/>
                                <Button Style="{StaticResource BarGlyph}" Content="&#xE74A;" Command="{Binding MoveUpCommand}" ToolTip="Move up"/>
                                <Button Style="{StaticResource BarGlyph}" Content="&#xE74B;" Command="{Binding MoveDownCommand}" ToolTip="Move down"/>
                            </StackPanel>
                        </Border>
                        <Grid>
                            <ListBox x:Name="EntryList" ItemsSource="{Binding Entries}" SelectedItem="{Binding SelectedEntry}" Background="Transparent" BorderThickness="0" Padding="8,0,8,4"
                                     AllowDrop="True" PreviewMouseLeftButtonDown="EntryList_PreviewMouseLeftButtonDown" PreviewMouseMove="EntryList_PreviewMouseMove" Drop="EntryList_Drop" DragOver="EntryList_DragOver"
                                     Tag="{Binding}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:SetlistEntry}">
                                        <DockPanel Margin="0,3" Background="Transparent" Tag="{Binding Tag, RelativeSource={RelativeSource AncestorType=ListBox}}">
                                            <DockPanel.ContextMenu>
                                                <ContextMenu>
                                                    <MenuItem Header="Move Up" Command="{Binding PlacementTarget.Tag.MoveUpCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}"/>
                                                    <MenuItem Header="Move Down" Command="{Binding PlacementTarget.Tag.MoveDownCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}"/>
                                                    <Separator/>
                                                    <MenuItem Header="Remove from Setlist" InputGestureText="Delete" Command="{Binding PlacementTarget.Tag.RemoveSongCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}"/>
                                                </ContextMenu>
                                            </DockPanel.ContextMenu>
                                            <TextBlock DockPanel.Dock="Left" Text="{Binding Number}" Width="26" FontSize="13" Opacity="0.55" Typography.NumeralAlignment="Tabular" VerticalAlignment="Center"/>
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding Detail}" FontSize="12" Opacity="0.65" VerticalAlignment="Center" Margin="10,0,0,0"/>
                                            <TextBlock Text="{Binding Title}" FontSize="14" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                        </DockPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="340" Visibility="{Binding Entries.Count, Converter={StaticResource NoneVis}}">
                                <TextBlock Text="No Songs Yet" Style="{StaticResource HeadlineText}" HorizontalAlignment="Center"/>
                                <TextBlock Style="{StaticResource SecondaryText}" TextAlignment="Center" Margin="0,4,0,0"
                                           Text="Double-click a column on the right to add it. Columns that aren't in the library yet are added as new songs."/>
                            </StackPanel>
                        </Grid>
                    </DockPanel>
                </Border>

                <!-- songs to add: Resolume's columns on the song layer -->
                <Border Grid.Column="2" Style="{StaticResource InsetGroup}" Padding="0">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Top" Margin="16,12,16,8">
                            <TextBlock Text="Add Songs" Style="{StaticResource HeadlineText}"/>
                            <TextBlock Text="{Binding SourceHeader}" Style="{StaticResource CaptionText}" FontSize="12" Margin="0,2,0,8"/>
                            <TextBox Style="{StaticResource SearchBox}" app:Ui.Placeholder="Search columns" Text="{Binding SourceSearch, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                        <Border DockPanel.Dock="Bottom" Style="{StaticResource ListBar}">
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Content="Add to Setlist" Command="{Binding AddSongCommand}"/>
                                <TextBlock Text="or double-click" Style="{StaticResource CaptionText}" VerticalAlignment="Center"/>
                            </DockPanel>
                        </Border>
                        <ListBox ItemsSource="{Binding Sources}" SelectedItem="{Binding SelectedSource}" Background="Transparent" BorderThickness="0" Padding="8,0,8,4" MouseDoubleClick="Source_MouseDoubleClick">
                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:SourceItem}">
                                    <StackPanel Margin="0,2">
                                        <TextBlock Text="{Binding Title}" FontSize="13" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding Detail}" FontSize="11" Opacity="0.65" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </Border>
            </Grid>
        </DockPanel>

        <!-- behind the sidebar when it slides over the content on narrow windows; a click here closes it -->
        <Border x:Name="Scrim" Grid.ColumnSpan="3" Panel.ZIndex="9" Background="#73000000" Visibility="Collapsed" MouseLeftButtonDown="Scrim_MouseLeftButtonDown"/>
    </Grid>
</UserControl>
