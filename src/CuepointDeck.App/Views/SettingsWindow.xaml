<Window x:Class="CuepointDeck.App.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:app="clr-namespace:CuepointDeck.App"
        Title="Settings" Style="{StaticResource AppWindow}" Background="{StaticResource BgBrush}"
        Width="640" SizeToContent="Height" ResizeMode="CanMinimize" WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Window.Resources>
        <app:BoolToVisibilityConverter x:Key="Vis"/>
        <app:BoolToVisibilityConverter x:Key="VisInv" Invert="True"/>
        <app:NullToVisibilityConverter x:Key="NotNullVis"/>
        <app:EqualsConverter x:Key="Is"/>

        <!-- this window is for keyboard and mouse alike: buttons take focus here -->
        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Focusable" Value="True"/>
        </Style>
        <Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
            <Setter Property="Focusable" Value="True"/>
            <Setter Property="Width" Value="250"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
        </Style>
        <!-- one row of a grouped form: label on the leading side, the control on the trailing side -->
        <Style x:Key="Row" TargetType="DockPanel">
            <Setter Property="Margin" Value="14,9"/>
            <Setter Property="LastChildFill" Value="True"/>
        </Style>
        <Style x:Key="RowLabel" TargetType="TextBlock">
            <Setter Property="DockPanel.Dock" Value="Left"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{StaticResource InkBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,16,0"/>
        </Style>
        <Style x:Key="Group" TargetType="Border" BasedOn="{StaticResource InsetGroup}">
            <Setter Property="Padding" Value="0,2"/>
        </Style>
        <Style x:Key="Footnote" TargetType="TextBlock" BasedOn="{StaticResource SecondaryText}">
            <Setter Property="Margin" Value="14,6,14,16"/>
            <Setter Property="FontSize" Value="11.5"/>
        </Style>
        <Style x:Key="GroupTitle" TargetType="TextBlock" BasedOn="{StaticResource SectionHeader}">
            <Setter Property="Margin" Value="14,0,0,6"/>
        </Style>
        <Style x:Key="Divider" TargetType="Rectangle">
            <Setter Property="Height" Value="1"/>
            <Setter Property="Fill" Value="{StaticResource SeparatorBrush}"/>
            <Setter Property="Margin" Value="14,0"/>
        </Style>
        <Style x:Key="ErrorText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource DangerBrush}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="14,0,14,14"/>
        </Style>
    </Window.Resources>

    <DockPanel>
        <!-- pane bar -->
        <Border DockPanel.Dock="Top" Background="{StaticResource SidebarBrush}" BorderBrush="{StaticResource SeparatorBrush}" BorderThickness="0,0,0,1" Padding="0,8">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <RadioButton Style="{StaticResource PaneTab}" GroupName="Pane" app:Ui.Icon="&#xE713;" Content="General" IsChecked="{Binding Pane, Converter={StaticResource Is}, ConverterParameter=general}"/>
                <RadioButton Style="{StaticResource PaneTab}" GroupName="Pane" app:Ui.Icon="&#xE703;" Content="Resolume" IsChecked="{Binding Pane, Converter={StaticResource Is}, ConverterParameter=resolume}"/>
                <RadioButton Style="{StaticResource PaneTab}" GroupName="Pane" app:Ui.Icon="&#xE8F1;" Content="Library" IsChecked="{Binding Pane, Converter={StaticResource Is}, ConverterParameter=library}"/>
                <RadioButton Style="{StaticResource PaneTab}" GroupName="Pane" app:Ui.Icon="&#xE714;" Content="Media" IsChecked="{Binding Pane, Converter={StaticResource Is}, ConverterParameter=media}"/>
                <RadioButton Style="{StaticResource PaneTab}" GroupName="Pane" app:Ui.Icon="&#xE895;" Content="Transfer" IsChecked="{Binding Pane, Converter={StaticResource Is}, ConverterParameter=transfer}"/>
                <RadioButton Style="{StaticResource PaneTab}" GroupName="Pane" app:Ui.Icon="&#xE946;" Content="About" IsChecked="{Binding Pane, Converter={StaticResource Is}, ConverterParameter=about}"/>
            </StackPanel>
        </Border>

        <Grid Margin="22,18,22,6">
            <!-- ======================================================================= General -->
            <StackPanel>
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Pane}" Value="general"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>

                <Border Style="{StaticResource Group}">
                    <StackPanel>
                        <DockPanel Style="{StaticResource Row}">
                            <TextBlock Style="{StaticResource RowLabel}" Text="This PC"/>
                            <ComboBox SelectedIndex="{Binding RoleIndex}">
                                <ComboBoxItem Content="Controls the deck"/>
                                <ComboBoxItem Content="Follows, read only"/>
                            </ComboBox>
                        </DockPanel>
                    </StackPanel>
                </Border>
                <TextBlock Style="{StaticResource Footnote}" Text="A following PC shows the same deck on a second screen but can't fire, queue, loop or launch anything."/>

                <Border Style="{StaticResource Group}">
                    <StackPanel>
                        <DockPanel Style="{StaticResource Row}">
                            <TextBlock Style="{StaticResource RowLabel}" Text="A click or number key"/>
                            <ComboBox SelectedIndex="{Binding DefaultTriggerIndex}">
                                <ComboBoxItem Content="Queues (Shift jumps now)"/>
                                <ComboBoxItem Content="Jumps now (Shift queues)"/>
                            </ComboBox>
                        </DockPanel>
                        <Rectangle Style="{StaticResource Divider}"/>
                        <DockPanel Style="{StaticResource Row}">
                            <TextBlock Style="{StaticResource RowLabel}" Text="Launch songs that aren't live"/>
                            <CheckBox Style="{StaticResource Switch}" HorizontalAlignment="Right" IsChecked="{Binding LaunchSongsFromSetlist}"/>
                        </DockPanel>
                    </StackPanel>
                </Border>
                <TextBlock Style="{StaticResource Footnote}" Text="Queue waits for the current segment to end, then jumps. With launching on, firing a segment of a song that isn't live brings that song up at the segment; otherwise the card flashes red and nothing is sent."/>

                <Border Style="{StaticResource Group}">
                    <StackPanel>
                        <DockPanel Style="{StaticResource Row}">
                            <TextBlock Style="{StaticResource RowLabel}" Text="Card size"/>
                            <TextBlock DockPanel.Dock="Right" Text="{Binding CardScaleText}" Style="{StaticResource TimecodeText}" FontWeight="Normal" Width="34" TextAlignment="Right" VerticalAlignment="Center" Margin="10,0,0,0"/>
                            <Slider Minimum="0.6" Maximum="2.0" Value="{Binding CardScale}" TickFrequency="0.1" IsSnapToTickEnabled="True" VerticalAlignment="Center" Width="220" HorizontalAlignment="Right"/>
                        </DockPanel>
                        <Rectangle Style="{StaticResource Divider}"/>
                        <DockPanel Style="{StaticResource Row}">
                            <TextBlock Style="{StaticResource RowLabel}" Text="Ask before quitting"/>
                            <CheckBox Style="{StaticResource Switch}" HorizontalAlignment="Right" IsChecked="{Binding ConfirmQuit}"/>
                        </DockPanel>
                    </StackPanel>
                </Border>
                <TextBlock Style="{StaticResource Footnote}" Text="Ctrl + and Ctrl − change the card size from Show mode too. Keep on Top is the pin in the toolbar."/>
            </StackPanel>

            <!-- ======================================================================= Resolume -->
            <StackPanel>
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Pane}" Value="resolume"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>

                <Border Style="{StaticResource InsetGroup}" Margin="0,0,0,16">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="10" Height="10" VerticalAlignment="Center">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Setter Property="Fill" Value="{StaticResource DangerBrush}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsConnected}" Value="True"><Setter Property="Fill" Value="{StaticResource AccentBrush}"/></DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                        <TextBlock Text="{Binding ConnectionSummary}" Margin="10,0,0,0" TextWrapping="Wrap" MaxWidth="530"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Group}">
                    <StackPanel>
                        <DockPanel Style="{StaticResource Row}">
                            <TextBlock Style="{StaticResource RowLabel}" Text="Address"/>
                            <TextBox Text="{Binding Host}" app:Ui.CommitOnEnter="True" app:Ui.Placeholder="127.0.0.1" Width="250" HorizontalAlignment="Right"
                                     ToolTip="127.0.0.1 on the Resolume PC itself, or the Resolume PC's IP address from the operator PC"/>
                        </DockPanel>
                        <Rectangle Style="{StaticResource Divider}"/>
                        <DockPanel Style="{StaticResource Row}">
                            <TextBlock Style="{StaticResource RowLabel}" Text="Port"/>
                            <TextBox Text="{Binding Port}" app:Ui.CommitOnEnter="True" Width="90" HorizontalAlignment="Right"/>
                        </DockPanel>
                        <Rectangle Style="{StaticResource Divider}"/>
                        <DockPanel Style="{StaticResource Row}">
                            <TextBlock Style="{StaticResource RowLabel}" Text="Song layer"/>
                            <TextBox Text="{Binding SongLayer}" app:Ui.CommitOnEnter="True" Width="90" HorizontalAlignment="Right"/>
                        </DockPanel>
                    </StackPanel>
                </Border>
                <TextBlock Style="{StaticResource Footnote}" Text="Turn on Resolume's web server in Arena's Preferences → Webserver. The song layer is the one whose clips are your songs; copies of the same file on other layers are ignored."/>

                <Border Style="{StaticResource Group}">
                    <DockPanel Style="{StaticResource Row}">
                        <TextBlock Style="{StaticResource RowLabel}" Text="{Binding LatencyLabel}"/>
                        <TextBlock DockPanel.Dock="Right" Text="ms" Style="{StaticResource SecondaryText}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                        <TextBox Text="{Binding LatencyOffset}" app:Ui.CommitOnEnter="True" Width="90" HorizontalAlignment="Right"/>
                    </DockPanel>
                </Border>
                <TextBlock Style="{StaticResource Footnote}" Text="How early a queued jump is sent so it lands on the boundary. Remembered per address. Start at 40 on the Resolume PC; raise it from another PC until queued jumps land on the beat."/>
                <TextBlock Style="{StaticResource ErrorText}" Text="{Binding ResolumeError}" Visibility="{Binding ResolumeError, Converter={StaticResource NotNullVis}}"/>
            </StackPanel>

            <!-- ======================================================================= Library -->
            <StackPanel>
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Pane}" Value="library"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>

                <Border Style="{StaticResource Group}">
                    <StackPanel>
                        <DockPanel Style="{StaticResource Row}">
                            <TextBlock Style="{StaticResource RowLabel}" Text="Folder"/>
                            <Button DockPanel.Dock="Right" Content="Choose…" Margin="8,0,0,0" Command="{Binding BrowseLibraryCommand}"/>
                            <TextBox Text="{Binding LibraryPath}" app:Ui.CommitOnEnter="True" ToolTip="A local folder, or a share both PCs can see"/>
                        </DockPanel>
                        <Rectangle Style="{StaticResource Divider}"/>
                        <DockPanel Style="{StaticResource Row}">
                            <Button DockPanel.Dock="Right" Content="Show in Explorer" Command="{Binding ShowLibraryFolderCommand}"/>
                            <TextBlock Text="{Binding LibrarySummary}" Style="{StaticResource SecondaryText}" VerticalAlignment="Center"/>
                        </DockPanel>
                    </StackPanel>
                </Border>
                <TextBlock Style="{StaticResource Footnote}" Text="Songs and setlists live here as small JSON files with their thumbnails. Point both PCs at the same share to work from one library."/>

                <TextBlock Style="{StaticResource GroupTitle}" Text="Path Mappings"/>
                <Border Style="{StaticResource InsetGroup}" Padding="10">
                    <TextBox Text="{Binding PathMappingsText}" AcceptsReturn="True" MinHeight="64" FontFamily="{StaticResource MonoFont}" FontSize="12" VerticalContentAlignment="Top"
                             app:Ui.Placeholder="D:\Media => \\CITY-VISUALS\Media"/>
                </Border>
                <TextBlock Style="{StaticResource Footnote}" Text="One per line. For editing on a PC that sees Resolume's media at a different path. Applied when you click away from the box."/>
                <TextBlock Style="{StaticResource ErrorText}" Text="{Binding LibraryError}" Visibility="{Binding LibraryError, Converter={StaticResource NotNullVis}}"/>
            </StackPanel>

            <!-- ======================================================================= Media -->
            <StackPanel>
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Pane}" Value="media"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>

                <Border Style="{StaticResource Group}">
                    <StackPanel>
                        <DockPanel Style="{StaticResource Row}">
                            <TextBlock Style="{StaticResource RowLabel}" Text="ffmpeg"/>
                            <Button DockPanel.Dock="Right" Content="Choose…" Margin="8,0,0,0" Command="{Binding BrowseFfmpegCommand}"/>
                            <TextBox Text="{Binding FfmpegPath}" app:Ui.CommitOnEnter="True" app:Ui.Placeholder="C:\Tools\ffmpeg\bin\ffmpeg.exe"/>
                        </DockPanel>
                        <Rectangle Style="{StaticResource Divider}"/>
                        <DockPanel Style="{StaticResource Row}">
                            <Button DockPanel.Dock="Right" Content="Check Again" Command="{Binding CheckFfmpegCommand}"/>
                            <TextBlock DockPanel.Dock="Left" VerticalAlignment="Top" Margin="0,2,8,0" FontSize="13">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource SymbolText}">
                                        <Setter Property="Text" Value="&#xE7BA;"/>
                                        <Setter Property="Foreground" Value="{StaticResource WarnBrush}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding FfmpegOk}" Value="True">
                                                <Setter Property="Text" Value="&#xE73E;"/>
                                                <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock Text="{Binding FfmpegStatus}" Style="{StaticResource SecondaryText}" VerticalAlignment="Center"/>
                        </DockPanel>
                    </StackPanel>
                </Border>
                <TextBlock Style="{StaticResource Footnote}" Text="Only Edit mode uses ffmpeg, for thumbnails, the preview player and suggested segments. Show mode never runs it. Unzip a Windows build anywhere and choose its bin\ffmpeg.exe; nothing needs installing."/>
            </StackPanel>

            <!-- ======================================================================= Transfer -->
            <StackPanel>
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Pane}" Value="transfer"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>

                <TextBlock Style="{StaticResource GroupTitle}" Text="Songs Between Campuses"/>
                <Border Style="{StaticResource Group}">
                    <StackPanel>
                        <DockPanel Style="{StaticResource Row}">
                            <Button DockPanel.Dock="Right" Content="Export Songs…" MinWidth="128" Command="{Binding ExportSongsCommand}" VerticalAlignment="Center" Margin="12,0,0,0"/>
                            <StackPanel>
                                <TextBlock Text="Export" Style="{StaticResource RowLabel}"/>
                                <TextBlock Text="Pick songs and save their timings to one file." Style="{StaticResource SecondaryText}" Margin="0,3,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                        </DockPanel>
                        <Rectangle Style="{StaticResource Divider}"/>
                        <DockPanel Style="{StaticResource Row}">
                            <Button DockPanel.Dock="Right" Content="Import Songs…" MinWidth="128" Command="{Binding ImportSongsCommand}" VerticalAlignment="Center" Margin="12,0,0,0"/>
                            <StackPanel>
                                <TextBlock Text="Import" Style="{StaticResource RowLabel}"/>
                                <TextBlock Text="Open a file from another campus and choose the column each song plays from here." Style="{StaticResource SecondaryText}" Margin="0,3,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                        </DockPanel>
                        <Rectangle Style="{StaticResource Divider}" Visibility="{Binding HasLastExport, Converter={StaticResource Vis}}"/>
                        <DockPanel Style="{StaticResource Row}" Visibility="{Binding HasLastExport, Converter={StaticResource Vis}}">
                            <Button DockPanel.Dock="Right" Content="Show in Explorer" Command="{Binding ShowLastExportCommand}" VerticalAlignment="Center" Margin="12,0,0,0"/>
                            <TextBlock Text="{Binding LastExportText}" Style="{StaticResource SecondaryText}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                        </DockPanel>
                    </StackPanel>
                </Border>
                <TextBlock Style="{StaticResource Footnote}" TextWrapping="Wrap"
                           Text="The file holds each song's segments: names, start and end times, colours and lyric notes. Media paths, Resolume columns and thumbnails differ between campuses, so they stay behind. On import each song is linked to a column on this PC's song layer, matched by name, and its thumbnails are rendered from the video here."/>
                <TextBlock Style="{StaticResource Footnote}" Margin="14,0,14,16" TextWrapping="Wrap"
                           Text="Exporting every song (Select All) also makes a backup of the library's timings."/>
            </StackPanel>

            <!-- ======================================================================= About -->
            <StackPanel>
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Pane}" Value="about"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>

                <StackPanel Orientation="Horizontal" Margin="4,0,0,16">
                    <Image Source="/Assets/cuepointdeck.png" Width="64" Height="64" RenderOptions.BitmapScalingMode="HighQuality"/>
                    <StackPanel Margin="16,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Cuepoint Deck" Style="{StaticResource TitleText}"/>
                        <TextBlock Text="{Binding VersionText}" Style="{StaticResource SecondaryText}" Margin="0,2,0,0"/>
                        <Button Style="{StaticResource LinkButton}" Content="{Binding RepoText}" Command="{Binding OpenRepoCommand}" Margin="0,4,0,0" HorizontalAlignment="Left"/>
                    </StackPanel>
                </StackPanel>
                <TextBlock Style="{StaticResource SecondaryText}" FontSize="12.5" Margin="4,0,4,16"
                           Text="Fires named sections of a song inside a Resolume Arena clip by moving its playhead. Resolume stays in charge of playback: nothing here can stop or pause output."/>

                <Border Style="{StaticResource Group}">
                    <StackPanel>
                        <DockPanel Style="{StaticResource Row}">
                            <Button DockPanel.Dock="Right" Content="{Binding UpdateButtonText}" Style="{StaticResource PrimaryButton}" Focusable="True" Command="{Binding CheckForUpdatesCommand}" IsEnabled="{Binding CanCheckForUpdates}" Margin="12,0,0,0"/>
                            <StackPanel>
                                <TextBlock Text="Updates" Style="{StaticResource RowLabel}"/>
                                <TextBlock Text="{Binding UpdateStatus}" Style="{StaticResource SecondaryText}" Margin="0,3,0,0"/>
                            </StackPanel>
                        </DockPanel>
                        <Rectangle Style="{StaticResource Divider}"/>
                        <DockPanel Style="{StaticResource Row}">
                            <Button DockPanel.Dock="Right" Content="Show Log Folder" Command="{Binding ShowLogFolderCommand}" Margin="8,0,0,0"/>
                            <Button DockPanel.Dock="Right" Content="Show Log" Command="{Binding ShowLogCommand}"/>
                            <StackPanel>
                                <TextBlock Text="Log" Style="{StaticResource RowLabel}"/>
                                <TextBlock Text="What the app has been doing, live. Kept for 14 days." Style="{StaticResource SecondaryText}" Margin="0,3,0,0"/>
                            </StackPanel>
                        </DockPanel>
                    </StackPanel>
                </Border>
                <TextBlock Style="{StaticResource Footnote}" Text=" "/>
            </StackPanel>
        </Grid>
    </DockPanel>
</Window>
