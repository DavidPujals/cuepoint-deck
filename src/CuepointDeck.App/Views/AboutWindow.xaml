<Window x:Class="CuepointDeck.App.Views.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="About Cuepoint Deck" Background="{StaticResource BgBrush}"
        Width="470" SizeToContent="Height" ResizeMode="NoResize" WindowStartupLocation="CenterOwner">
    <StackPanel Margin="22,20">
        <StackPanel Orientation="Horizontal">
            <Image Source="/Assets/cuepointdeck.ico" Width="52" Height="52"/>
            <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="Cuepoint Deck" FontSize="17" FontWeight="SemiBold"/>
                <TextBlock x:Name="VersionText" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,3,0,0"/>
            </StackPanel>
        </StackPanel>

        <TextBlock Margin="1,14,0,0" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" FontSize="12"
                   Text="Fires named sections of a song inside a Resolume Arena clip by moving its playhead. Resolume stays in charge of playback; nothing here can stop or pause output."/>

        <TextBlock Style="{StaticResource SectionLabel}" Text="DETAILS" Margin="1,16,0,6"/>
        <Grid Margin="1,0,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="88"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition/><RowDefinition/><RowDefinition/>
            </Grid.RowDefinitions>
            <Grid.Resources>
                <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                    <Setter Property="FontSize" Value="12"/>
                    <Setter Property="Margin" Value="0,0,0,5"/>
                </Style>
            </Grid.Resources>
            <TextBlock Grid.Row="0" Grid.Column="0" Text="Runtime" Foreground="{StaticResource MutedBrush}"/>
            <TextBlock Grid.Row="0" Grid.Column="1" Text=".NET 8 · WPF · self-contained single exe"/>
            <TextBlock Grid.Row="1" Grid.Column="0" Text="Resolume" Foreground="{StaticResource MutedBrush}"/>
            <TextBlock Grid.Row="1" Grid.Column="1" x:Name="ResolumeText" Text="Arena 7 REST + WebSocket API, port 8080"/>
            <TextBlock Grid.Row="2" Grid.Column="0" Text="Source" Foreground="{StaticResource MutedBrush}"/>
            <TextBlock Grid.Row="2" Grid.Column="1">
                <Hyperlink x:Name="RepoLink" RequestNavigate="Link_RequestNavigate" Foreground="#4E86D8">
                    <Run x:Name="RepoLinkText"/>
                </Hyperlink>
            </TextBlock>
        </Grid>

        <TextBlock Style="{StaticResource SectionLabel}" Text="UPDATES" Margin="1,14,0,6"/>
        <TextBlock x:Name="UpdateStatus" FontSize="12" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="1,0,0,8"
                   Text="Checks the latest GitHub release, downloads it and swaps the exe in place. Your settings and library are untouched."/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Close" MinWidth="90" Click="Close_Click"/>
            <Button x:Name="UpdateButton" Content="Check for updates" Style="{StaticResource PrimaryButton}" MinWidth="160" Margin="8,0,0,0" Click="Update_Click"/>
        </StackPanel>
    </StackPanel>
</Window>
