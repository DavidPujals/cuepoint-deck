<Window x:Class="CuepointDeck.App.Views.PromptSheet"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cuepoint Deck" Style="{StaticResource AppWindow}" Width="440" Background="{StaticResource SheetBrush}">
    <Border Background="{StaticResource SheetBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1">
        <StackPanel Margin="22,20,22,18">
            <TextBlock x:Name="TitleText" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap"/>
            <TextBlock x:Name="MessageText" Style="{StaticResource SecondaryText}" FontSize="13" Margin="0,4,0,0"/>
            <TextBox x:Name="Box" FontSize="14" Margin="0,14,0,0" TextChanged="Box_TextChanged"/>
            <TextBlock x:Name="ErrorText" Foreground="{StaticResource DangerBrush}" FontSize="12" Margin="2,6,0,0" TextWrapping="Wrap" Visibility="Collapsed"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                <Button Content="Cancel" MinWidth="92" IsCancel="True" Focusable="True"/>
                <Button x:Name="ActionButton" Style="{StaticResource PrimaryButton}" MinWidth="92" Margin="8,0,0,0" IsDefault="True" Focusable="True" Click="Action_Click"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
