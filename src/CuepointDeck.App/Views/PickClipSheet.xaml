<Window x:Class="CuepointDeck.App.Views.PickClipSheet"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:app="clr-namespace:CuepointDeck.App"
        xmlns:vm="clr-namespace:CuepointDeck.App.ViewModels"
        Title="New Song from Resolume" Style="{StaticResource AppWindow}" Width="560" Background="{StaticResource SheetBrush}">
    <Window.Resources>
        <app:NullToVisibilityConverter x:Key="NotNullVis"/>
    </Window.Resources>
    <Border Background="{StaticResource SheetBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1">
        <StackPanel Margin="22,20,22,18">
            <TextBlock x:Name="TitleText" Text="New Song from Resolume" FontSize="15" FontWeight="SemiBold"/>
            <TextBlock x:Name="HintText" Style="{StaticResource SecondaryText}" FontSize="13" Margin="0,4,0,0"/>
            <TextBox x:Name="Search" Style="{StaticResource SearchBox}" app:Ui.Placeholder="Search columns" Margin="0,14,0,8" TextChanged="Search_TextChanged"/>
            <ListBox x:Name="List" Height="320" MouseDoubleClick="List_MouseDoubleClick" SelectionChanged="List_SelectionChanged" Focusable="True">
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:CompositionClipItem}">
                        <DockPanel Margin="2,1">
                            <Border DockPanel.Dock="Right" Style="{StaticResource Badge}" Visibility="{Binding ExistingSong, Converter={StaticResource NotNullVis}}">
                                <TextBlock Text="In Library" FontSize="11" Foreground="{StaticResource MutedBrush}"/>
                            </Border>
                            <StackPanel>
                                <TextBlock Text="{Binding Title}" FontSize="14" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding Detail}" Style="{StaticResource CaptionText}"/>
                            </StackPanel>
                        </DockPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <TextBlock x:Name="EmptyText" Style="{StaticResource SecondaryText}" Margin="2,8,0,0" Visibility="Collapsed"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                <Button Content="Cancel" MinWidth="92" IsCancel="True" Focusable="True"/>
                <Button x:Name="ActionButton" Content="Create Song" Style="{StaticResource PrimaryButton}" MinWidth="110" Margin="8,0,0,0" IsDefault="True" Focusable="True" Click="Action_Click"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
