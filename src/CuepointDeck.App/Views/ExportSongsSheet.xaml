<Window x:Class="CuepointDeck.App.Views.ExportSongsSheet"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:app="clr-namespace:CuepointDeck.App"
        xmlns:vm="clr-namespace:CuepointDeck.App.ViewModels"
        Title="Export Songs" Style="{StaticResource AppWindow}" Width="540" Background="{StaticResource SheetBrush}">
    <Border Background="{StaticResource SheetBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1">
        <StackPanel Margin="22,20,22,18">
            <TextBlock Text="Export Songs" FontSize="15" FontWeight="SemiBold"/>
            <TextBlock Style="{StaticResource SecondaryText}" FontSize="13" Margin="0,4,0,0" TextWrapping="Wrap"
                       Text="Pick the songs to take to another campus. Their timings, segment names, colours and lyric notes go into one file. Media paths, Resolume columns and thumbnails stay here."/>
            <TextBox x:Name="Search" Style="{StaticResource SearchBox}" app:Ui.Placeholder="Search songs" Margin="0,14,0,8" TextChanged="Search_TextChanged"/>
            <Border Background="{StaticResource FieldBrush}" BorderBrush="{StaticResource SeparatorBrush}" BorderThickness="1" CornerRadius="8" Height="320">
                <Grid>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False" Padding="4">
                        <ItemsControl x:Name="List" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:ExportSongItem}">
                                    <CheckBox IsChecked="{Binding IsChecked}" Focusable="True" Margin="6,3" VerticalContentAlignment="Center" HorizontalContentAlignment="Stretch">
                                        <StackPanel Margin="4,0,0,0">
                                            <TextBlock Text="{Binding Title}" FontSize="14" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding Detail}" Style="{StaticResource CaptionText}" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                    </CheckBox>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    <TextBlock x:Name="EmptyText" Text="No songs match." Style="{StaticResource SecondaryText}" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
                </Grid>
            </Border>
            <DockPanel Margin="2,8,2,0">
                <TextBlock x:Name="CountText" DockPanel.Dock="Right" Style="{StaticResource CaptionText}" VerticalAlignment="Center"/>
                <StackPanel Orientation="Horizontal">
                    <Button x:Name="AllButton" Style="{StaticResource LinkButton}" Content="Select All" Click="All_Click"/>
                    <Button Style="{StaticResource LinkButton}" Content="Select None" Margin="14,0,0,0" Click="None_Click"/>
                </StackPanel>
            </DockPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                <Button Content="Cancel" MinWidth="92" IsCancel="True" Focusable="True"/>
                <Button x:Name="ActionButton" Content="Export…" Style="{StaticResource PrimaryButton}" MinWidth="110" Margin="8,0,0,0" IsDefault="True" Focusable="True" Click="Action_Click"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
