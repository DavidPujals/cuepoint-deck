<Window x:Class="CuepointDeck.App.Views.Alert"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cuepoint Deck" Style="{StaticResource AppWindow}" Width="460" Background="{StaticResource SheetBrush}">
    <Border Background="{StaticResource SheetBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1">
        <Grid Margin="22,22,22,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <!-- alerts carry the app icon, as on the Mac: the question comes from this app -->
            <Image Source="/Assets/cuepointdeck.png" Width="52" Height="52" VerticalAlignment="Top" RenderOptions.BitmapScalingMode="HighQuality"/>
            <StackPanel Grid.Column="1" Margin="18,0,0,0">
                <TextBlock x:Name="TitleText" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap"/>
                <TextBlock x:Name="MessageText" Style="{StaticResource SecondaryText}" FontSize="13" Margin="0,6,0,0" LineHeight="19"/>
                <CheckBox x:Name="Suppress" Margin="0,14,0,0" Visibility="Collapsed" Focusable="True"/>
                <DockPanel Margin="0,22,0,0" LastChildFill="False">
                    <StackPanel x:Name="Leading" DockPanel.Dock="Left" Orientation="Horizontal"/>
                    <StackPanel x:Name="Trailing" DockPanel.Dock="Right" Orientation="Horizontal"/>
                </DockPanel>
            </StackPanel>
        </Grid>
    </Border>
</Window>
