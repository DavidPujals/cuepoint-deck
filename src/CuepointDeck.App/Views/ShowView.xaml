<UserControl x:Class="CuepointDeck.App.Views.ShowView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:app="clr-namespace:CuepointDeck.App"
             xmlns:vm="clr-namespace:CuepointDeck.App.ViewModels"
             xmlns:ctl="clr-namespace:CuepointDeck.App.Controls"
             Focusable="False">
    <UserControl.Resources>
        <app:HexToBrushConverter x:Key="Hex"/>
        <app:BoolToVisibilityConverter x:Key="Vis"/>
        <app:BoolToVisibilityConverter x:Key="VisInv" Invert="True"/>
        <app:NullToVisibilityConverter x:Key="NotNullVis"/>
        <app:ScaleConverter x:Key="Scale"/>
        <app:ImageAspectConverter x:Key="Aspect"/>

        <!-- small dark capsules laid over a thumbnail -->
        <Style x:Key="Overlay" TargetType="Border">
            <Setter Property="Background" Value="#B3000000"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="6,1"/>
            <Setter Property="Margin" Value="6"/>
        </Style>

        <!-- one segment card. Click fires it with the default trigger; Shift-click the other; right-click for the menu. -->
        <DataTemplate x:Key="CardTemplate" DataType="{x:Type vm:SegmentCardViewModel}">
            <Border x:Name="Card" Margin="6" CornerRadius="12" BorderThickness="2" BorderBrush="{StaticResource SeparatorBrush}"
                    Background="{StaticResource PanelBrush}" Cursor="Hand"
                    Width="{Binding DataContext.CardScale, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource Scale}, ConverterParameter=240}"
                    MouseLeftButtonUp="Card_MouseLeftButtonUp" ToolTip="{Binding RangeText}">
                <Border.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Jump Now" InputGestureText="{Binding CutGesture}" Command="{Binding CutCommand}"/>
                        <MenuItem Header="Jump at End of Current Segment" InputGestureText="{Binding QueueGesture}" Command="{Binding QueueCommand}"/>
                        <Separator/>
                        <MenuItem Header="Loop This Segment" IsChecked="{Binding IsLooping, Mode=OneWay}" Command="{Binding ToggleLoopCommand}"/>
                        <Separator/>
                        <MenuItem Header="Edit Segment" Command="{Binding EditCommand}"/>
                    </ContextMenu>
                </Border.ContextMenu>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- thumbnail at the clip's own shape, or the segment colour with its name -->
                    <ctl:AspectBox Grid.Row="0" Ratio="{Binding Thumb, Converter={StaticResource Aspect}}" ClipToBounds="True">
                        <Grid>
                            <Border Background="{Binding ColorHex, Converter={StaticResource Hex}, ConverterParameter=0.5}" CornerRadius="10,10,0,0">
                                <TextBlock Text="{Binding Name}" FontFamily="{StaticResource DisplayFont}" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center" Margin="10" Opacity="0.9"/>
                            </Border>
                            <Border CornerRadius="10,10,0,0" Visibility="{Binding HasThumb, Converter={StaticResource Vis}}">
                                <Border.Background>
                                    <ImageBrush ImageSource="{Binding Thumb}" Stretch="Uniform"/>
                                </Border.Background>
                            </Border>
                            <Border Style="{StaticResource Overlay}" HorizontalAlignment="Left" VerticalAlignment="Top" Padding="8,1" Visibility="{Binding NumberLabel, Converter={StaticResource NotNullVis}}">
                                <TextBlock Text="{Binding NumberLabel}" FontSize="15" FontWeight="Bold" Foreground="White"/>
                            </Border>
                            <Border Style="{StaticResource Overlay}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="6,6,36,6" Padding="8,2" Background="#E6000000" Visibility="{Binding IsQueued, Converter={StaticResource Vis}}">
                                <TextBlock Text="{Binding QueueText}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource WarnBrush}" Typography.NumeralAlignment="Tabular"/>
                            </Border>
                            <Border Style="{StaticResource Overlay}" HorizontalAlignment="Right" VerticalAlignment="Bottom" Visibility="{Binding IsNext, Converter={StaticResource Vis}}">
                                <TextBlock Text="Next" FontSize="11" Foreground="#C8CED6"/>
                            </Border>
                            <!-- loop: repeats this segment at its end until turned off; tinted when on -->
                            <ToggleButton HorizontalAlignment="Right" VerticalAlignment="Top" Margin="6" Width="26" Height="24" FontSize="13"
                                          Style="{StaticResource LoopButton}" IsChecked="{Binding IsLooping, Mode=OneWay}" Command="{Binding ToggleLoopCommand}"
                                          Content="&#xE8EE;" ToolTip="Loop: at its end, go back to its start. L loops the live segment; Esc stops."/>
                            <Border Style="{StaticResource Overlay}" HorizontalAlignment="Left" VerticalAlignment="Bottom">
                                <TextBlock Text="{Binding StartText}" FontSize="11" Foreground="#C8CED6" Typography.NumeralAlignment="Tabular"/>
                            </Border>
                        </Grid>
                    </ctl:AspectBox>

                    <DockPanel Grid.Row="1" Margin="0,8,0,0">
                        <Rectangle DockPanel.Dock="Left" Width="5" Margin="10,1,0,1" RadiusX="2.5" RadiusY="2.5" Fill="{Binding ColorHex, Converter={StaticResource Hex}}"/>
                        <TextBlock Text="{Binding Name}" FontSize="18" FontWeight="SemiBold" Margin="9,0,10,0" TextTrimming="CharacterEllipsis"/>
                    </DockPanel>
                    <TextBlock Grid.Row="2" Text="{Binding Lyric}" FontSize="13" Foreground="{StaticResource MutedBrush}" Margin="24,2,10,8" TextTrimming="CharacterEllipsis" MaxHeight="36" TextWrapping="Wrap"/>
                    <ProgressBar Grid.Row="3" Height="4" Minimum="0" Maximum="1" Value="{Binding Progress, Mode=OneWay}" Margin="10,0,10,9"
                                 Background="#0F1215" BorderThickness="0" Foreground="{Binding ColorHex, Converter={StaticResource Hex}}"/>
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <Trigger SourceName="Card" Property="IsMouseOver" Value="True">
                    <Setter TargetName="Card" Property="BorderBrush" Value="#3A424D"/>
                </Trigger>
                <DataTrigger Binding="{Binding IsLive}" Value="True">
                    <Setter TargetName="Card" Property="BorderBrush" Value="{Binding ColorHex, Converter={StaticResource Hex}}"/>
                    <Setter TargetName="Card" Property="Background" Value="{Binding ColorHex, Converter={StaticResource Hex}, ConverterParameter=0.2}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsQueued}" Value="True">
                    <Setter TargetName="Card" Property="BorderBrush" Value="{StaticResource WarnBrush}"/>
                    <DataTrigger.EnterActions>
                        <BeginStoryboard x:Name="Pulse">
                            <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                <DoubleAnimation Storyboard.TargetName="Card" Storyboard.TargetProperty="BorderBrush.Opacity" From="1" To="0.3" Duration="0:0:0.6"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </DataTrigger.EnterActions>
                    <DataTrigger.ExitActions>
                        <StopStoryboard BeginStoryboardName="Pulse"/>
                    </DataTrigger.ExitActions>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsFlashing}" Value="True">
                    <Setter TargetName="Card" Property="BorderBrush" Value="{StaticResource DangerBrush}"/>
                    <Setter TargetName="Card" Property="Background" Value="#4DFF453A"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding DataContext.CanFire, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="False">
                    <Setter TargetName="Card" Property="Opacity" Value="0.5"/>
                    <Setter TargetName="Card" Property="Cursor" Value="Arrow"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
        <!-- a slim trigger tile for short windows: number, name, loop, and the time or queue countdown; same clicks and menu -->
        <DataTemplate x:Key="TileTemplate" DataType="{x:Type vm:SegmentCardViewModel}">
            <Border x:Name="Card" Margin="4" CornerRadius="9" BorderThickness="2" BorderBrush="{StaticResource SeparatorBrush}"
                    Background="{StaticResource PanelBrush}" Cursor="Hand" MinWidth="150" Padding="8,5,6,0"
                    Width="{Binding DataContext.CardScale, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource Scale}, ConverterParameter=220}"
                    MouseLeftButtonUp="Card_MouseLeftButtonUp" ToolTip="{Binding RangeText}">
                <Border.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Jump Now" InputGestureText="{Binding CutGesture}" Command="{Binding CutCommand}"/>
                        <MenuItem Header="Jump at End of Current Segment" InputGestureText="{Binding QueueGesture}" Command="{Binding QueueCommand}"/>
                        <Separator/>
                        <MenuItem Header="Loop This Segment" IsChecked="{Binding IsLooping, Mode=OneWay}" Command="{Binding ToggleLoopCommand}"/>
                        <Separator/>
                        <MenuItem Header="Edit Segment" Command="{Binding EditCommand}"/>
                    </ContextMenu>
                </Border.ContextMenu>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <DockPanel Grid.Row="0">
                        <Border DockPanel.Dock="Left" Background="{Binding ColorHex, Converter={StaticResource Hex}}" CornerRadius="5" Padding="6,0" MinWidth="20" Margin="0,0,8,0" VerticalAlignment="Center"
                                Visibility="{Binding NumberLabel, Converter={StaticResource NotNullVis}}">
                            <TextBlock Text="{Binding NumberLabel}" FontSize="12" FontWeight="Bold" Foreground="#0F1215" HorizontalAlignment="Center"/>
                        </Border>
                        <ToggleButton DockPanel.Dock="Right" Width="24" Height="22" FontSize="12" Margin="4,0,0,0" Background="Transparent"
                                      Style="{StaticResource LoopButton}" IsChecked="{Binding IsLooping, Mode=OneWay}" Command="{Binding ToggleLoopCommand}"
                                      Content="&#xE8EE;" ToolTip="Loop: at its end, go back to its start. L loops the live segment; Esc stops."/>
                        <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                    </DockPanel>
                    <TextBlock x:Name="Sub" Grid.Row="1" Text="{Binding StartText}" FontSize="11" Opacity="0.65" Margin="0,1,0,3" Typography.NumeralAlignment="Tabular" TextTrimming="CharacterEllipsis"/>
                    <ProgressBar Grid.Row="2" Height="3" Minimum="0" Maximum="1" Value="{Binding Progress, Mode=OneWay}" Margin="-6,0,-4,0"
                                 Background="Transparent" BorderThickness="0" Foreground="{Binding ColorHex, Converter={StaticResource Hex}}"/>
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <Trigger SourceName="Card" Property="IsMouseOver" Value="True">
                    <Setter TargetName="Card" Property="BorderBrush" Value="#3A424D"/>
                </Trigger>
                <DataTrigger Binding="{Binding IsNext}" Value="True">
                    <Setter TargetName="Sub" Property="Text" Value="Next"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsLive}" Value="True">
                    <Setter TargetName="Card" Property="BorderBrush" Value="{Binding ColorHex, Converter={StaticResource Hex}}"/>
                    <Setter TargetName="Card" Property="Background" Value="{Binding ColorHex, Converter={StaticResource Hex}, ConverterParameter=0.2}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsQueued}" Value="True">
                    <Setter TargetName="Card" Property="BorderBrush" Value="{StaticResource WarnBrush}"/>
                    <Setter TargetName="Sub" Property="Text" Value="{Binding QueueText}"/>
                    <Setter TargetName="Sub" Property="Foreground" Value="{StaticResource WarnBrush}"/>
                    <Setter TargetName="Sub" Property="Opacity" Value="1"/>
                    <DataTrigger.EnterActions>
                        <BeginStoryboard x:Name="TilePulse">
                            <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                <DoubleAnimation Storyboard.TargetName="Card" Storyboard.TargetProperty="BorderBrush.Opacity" From="1" To="0.3" Duration="0:0:0.6"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </DataTrigger.EnterActions>
                    <DataTrigger.ExitActions>
                        <StopStoryboard BeginStoryboardName="TilePulse"/>
                    </DataTrigger.ExitActions>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsFlashing}" Value="True">
                    <Setter TargetName="Card" Property="BorderBrush" Value="{StaticResource DangerBrush}"/>
                    <Setter TargetName="Card" Property="Background" Value="#4DFF453A"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding DataContext.CanFire, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="False">
                    <Setter TargetName="Card" Property="Opacity" Value="0.5"/>
                    <Setter TargetName="Card" Property="Cursor" Value="Arrow"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ===== the live song ===== -->
        <Border Grid.Row="0" Style="{StaticResource InsetGroup}" Padding="18,14,18,14" Margin="0,0,0,8" Visibility="{Binding ShowFullHeader, Converter={StaticResource Vis}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="{Binding SongTitle}" Style="{StaticResource LargeTitleText}"/>
                    <TextBlock Text="{Binding SongSubtitle}" Style="{StaticResource CaptionText}" FontSize="12" Margin="0,2,0,0"/>
                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{Binding ElapsedText}" Style="{StaticResource TimecodeText}" FontSize="22" Margin="0,0,14,0" VerticalAlignment="Center"/>
                        <ctl:SegmentProgressBar Grid.Column="1" Height="12" VerticalAlignment="Center" Progress="{Binding ClipProgress}" Ticks="{Binding Ticks}" TickColors="{Binding TickColors}" Gaps="{Binding Gaps}" Fill="{Binding ProgressFill}"/>
                        <TextBlock Grid.Column="2" Text="{Binding RemainingText}" Style="{StaticResource TimecodeText}" FontSize="22" Margin="14,0,0,0" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}"/>
                    </Grid>
                </StackPanel>
                <!-- why cards can't fire right now: one calm status capsule instead of shouting text -->
                <Border Grid.Column="1" Style="{StaticResource Badge}" Background="#3A2A10" VerticalAlignment="Top" Margin="16,4,0,0" Padding="10,4"
                        Visibility="{Binding CannotFireReason, Converter={StaticResource NotNullVis}}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE7BA;" Style="{StaticResource SymbolText}" FontSize="12" Foreground="{StaticResource WarnBrush}"/>
                        <TextBlock Text="{Binding CannotFireReason}" Foreground="{StaticResource WarnBrush}" FontSize="12" FontWeight="SemiBold" Margin="7,0,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- ===== the live song, one line, for short windows ===== -->
        <Border Grid.Row="0" Style="{StaticResource InsetGroup}" Padding="12,5" Margin="0,0,0,6" Visibility="{Binding ShowSlimHeader, Converter={StaticResource Vis}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" MaxWidth="320"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding SongTitle}" FontFamily="{StaticResource DisplayFont}" FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                           VerticalAlignment="Center" ToolTip="{Binding SongSubtitle}"/>
                <TextBlock Grid.Column="1" Text="{Binding ElapsedText}" Style="{StaticResource TimecodeText}" FontSize="15" Margin="14,0,10,0" VerticalAlignment="Center"/>
                <ctl:SegmentProgressBar Grid.Column="2" Height="8" VerticalAlignment="Center" Progress="{Binding ClipProgress}" Ticks="{Binding Ticks}" TickColors="{Binding TickColors}" Gaps="{Binding Gaps}" Fill="{Binding ProgressFill}"/>
                <TextBlock Grid.Column="3" Text="{Binding RemainingText}" Style="{StaticResource TimecodeText}" FontSize="15" Margin="10,0,0,0" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}"/>
                <Border Grid.Column="4" Style="{StaticResource Badge}" Background="#3A2A10" Margin="10,0,0,0" Padding="8,2" Visibility="{Binding CannotFireReason, Converter={StaticResource NotNullVis}}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE7BA;" Style="{StaticResource SymbolText}" FontSize="11" Foreground="{StaticResource WarnBrush}"/>
                        <TextBlock Text="{Binding CannotFireReason}" Foreground="{StaticResource WarnBrush}" FontSize="11.5" FontWeight="SemiBold" Margin="6,0,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- ===== cards ===== -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Focusable="False" Visibility="{Binding HasSong, Converter={StaticResource Vis}}">
            <ItemsControl ItemsSource="{Binding Cards}" Focusable="False" Margin="-6,0">
                <ItemsControl.Style>
                    <Style TargetType="ItemsControl">
                        <Setter Property="ItemTemplate" Value="{StaticResource CardTemplate}"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsMinimal}" Value="True"><Setter Property="ItemTemplate" Value="{StaticResource TileTemplate}"/></DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ItemsControl.Style>
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>
        </ScrollViewer>

        <!-- ===== nothing to show: say why, and what to do ===== -->
        <StackPanel Grid.Row="0" Grid.RowSpan="2" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="460" Visibility="{Binding HasSong, Converter={StaticResource VisInv}}">
            <TextBlock Text="&#xE8D6;" Style="{StaticResource SymbolText}" FontSize="44" Foreground="{StaticResource TertiaryBrush}" HorizontalAlignment="Center" Margin="0,0,0,14"
                       Visibility="{Binding IsCompact, Converter={StaticResource VisInv}}"/>
            <TextBlock Text="{Binding EmptyTitle}" Style="{StaticResource TitleText}" HorizontalAlignment="Center"/>
            <TextBlock Text="{Binding EmptyMessage}" Style="{StaticResource SecondaryText}" FontSize="13" TextAlignment="Center" Margin="0,6,0,0"/>
            <Button Content="Add to Library…" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Center" Margin="0,16,0,0"
                    Command="{Binding AddUnknownClipCommand}" Visibility="{Binding IsUnknownClip, Converter={StaticResource Vis}}"/>
        </StackPanel>
    </Grid>
</UserControl>
