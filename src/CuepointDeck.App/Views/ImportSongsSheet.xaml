<Window x:Class="CuepointDeck.App.Views.ImportSongsSheet"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:app="clr-namespace:CuepointDeck.App"
        xmlns:vm="clr-namespace:CuepointDeck.App.ViewModels"
        Title="Import Songs" Style="{StaticResource AppWindow}" Width="780" Background="{StaticResource SheetBrush}">
    <Window.Resources>
        <Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
            <Setter Property="Focusable" Value="True"/>
        </Style>
    </Window.Resources>
    <Border Background="{StaticResource SheetBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1">
        <StackPanel Margin="22,20,22,18">
            <TextBlock Text="Import Songs" FontSize="15" FontWeight="SemiBold"/>
            <TextBlock x:Name="SourceText" Style="{StaticResource SecondaryText}" FontSize="13" Margin="0,4,0,0" TextWrapping="Wrap"/>

            <!-- not connected: songs can still come in, unlinked -->
            <Border x:Name="OfflineNotice" Background="#2A2418" BorderBrush="#5A4520" BorderThickness="1" CornerRadius="8" Padding="12,9" Margin="0,12,0,0" Visibility="Collapsed">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Left" Text="&#xE7BA;" Style="{StaticResource SymbolText}" Foreground="{StaticResource WarnBrush}" FontSize="14" VerticalAlignment="Top" Margin="0,1,10,0"/>
                    <TextBlock x:Name="OfflineText" TextWrapping="Wrap" FontSize="12.5"/>
                </DockPanel>
            </Border>

            <DockPanel Margin="2,14,2,6">
                <StackPanel x:Name="BulkLinks" DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Bottom">
                    <TextBlock Text="Songs already here:" Style="{StaticResource CaptionText}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <Button Style="{StaticResource LinkButton}" Content="Replace All" Click="ReplaceAll_Click"/>
                    <Button Style="{StaticResource LinkButton}" Content="Skip All" Margin="12,0,0,0" Click="SkipAll_Click"/>
                </StackPanel>
                <TextBlock Text="Songs in the File" Style="{StaticResource SectionHeader}" VerticalAlignment="Bottom"/>
            </DockPanel>

            <Border Background="{StaticResource FieldBrush}" BorderBrush="{StaticResource SeparatorBrush}" BorderThickness="1" CornerRadius="8">
                <ScrollViewer x:Name="Scroller" MaxHeight="380" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                    <ItemsControl x:Name="List" Focusable="False" Margin="0,2">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:ImportSongItem}">
                                <Grid Margin="14,9,12,9">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="236"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                                        <StackPanel.Style>
                                            <Style TargetType="StackPanel">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsSkipped}" Value="True"><Setter Property="Opacity" Value="0.45"/></DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </StackPanel.Style>
                                        <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding Detail}" Style="{StaticResource CaptionText}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Detail}"/>
                                        <TextBlock Text="{Binding Warning}" Foreground="{StaticResource WarnBrush}" FontSize="11.5" Margin="0,2,0,0" TextWrapping="Wrap">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Warning}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                    <Border Grid.Column="1" Style="{StaticResource SegmentedControl}" VerticalAlignment="Center" Margin="0,0,12,0">
                                        <StackPanel Orientation="Horizontal">
                                            <Button Style="{StaticResource SegmentItem}" Content="{Binding IncludeLabel}" MinWidth="70" Command="{Binding UseCommand}" app:Ui.IsSelected="{Binding Include}"/>
                                            <Button Style="{StaticResource SegmentItem}" Content="Skip" MinWidth="56" Command="{Binding SkipCommand}" app:Ui.IsSelected="{Binding IsSkipped}"/>
                                        </StackPanel>
                                    </Border>
                                    <ComboBox Grid.Column="2" ItemsSource="{Binding Columns}" SelectedItem="{Binding SelectedColumn}" DisplayMemberPath="Label"
                                              IsEnabled="{Binding Include}" VerticalAlignment="Center" MaxDropDownHeight="360" ToolTip="The Resolume column this song plays from here"/>
                                    <Rectangle Grid.ColumnSpan="3" Height="1" Fill="{StaticResource SeparatorBrush}" VerticalAlignment="Top" Margin="0,-9,0,0">
                                        <Rectangle.Style>
                                            <Style TargetType="Rectangle">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding RelativeSource={RelativeSource PreviousData}}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Rectangle.Style>
                                    </Rectangle>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>

            <TextBlock x:Name="HintText" Style="{StaticResource CaptionText}" Margin="2,8,2,0" TextWrapping="Wrap"/>

            <DockPanel Margin="0,18,0,0">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="Cancel" MinWidth="92" IsCancel="True" Focusable="True"/>
                    <Button x:Name="ActionButton" Content="Import" Style="{StaticResource PrimaryButton}" MinWidth="110" Margin="8,0,0,0" IsDefault="True" Focusable="True" Click="Action_Click"/>
                </StackPanel>
                <TextBlock x:Name="SummaryText" Style="{StaticResource SecondaryText}" VerticalAlignment="Center"/>
            </DockPanel>
        </StackPanel>
    </Border>
</Window>
