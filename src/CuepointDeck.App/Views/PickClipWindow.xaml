<Window x:Class="CuepointDeck.App.Views.PickClipWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="New song from the composition" Background="{StaticResource BgBrush}"
        Width="720" Height="520" WindowStartupLocation="CenterOwner">
    <DockPanel Margin="12">
        <TextBlock DockPanel.Dock="Top" x:Name="Hint" TextWrapping="Wrap" Text="Pick the clip this song plays from. Only clips on the song layer with a media file are listed." Foreground="{StaticResource MutedBrush}" Margin="0,0,0,8"/>
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="Cancel" MinWidth="90" Click="Cancel_Click"/>
            <Button Content="Create song" Style="{StaticResource PrimaryButton}" MinWidth="120" Margin="8,0,0,0" Click="Ok_Click"/>
        </StackPanel>
        <ListBox x:Name="List" Background="#11151A" BorderBrush="{StaticResource LineBrush}" Foreground="{StaticResource InkBrush}" DisplayMemberPath="Display" MouseDoubleClick="List_MouseDoubleClick" FontSize="14"/>
    </DockPanel>
</Window>
