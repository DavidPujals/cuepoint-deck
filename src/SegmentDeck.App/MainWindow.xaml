<Window x:Class="SegmentDeck.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:app="clr-namespace:SegmentDeck.App"
        xmlns:vm="clr-namespace:SegmentDeck.App.ViewModels"
        xmlns:views="clr-namespace:SegmentDeck.App.Views"
        Title="Segment Deck"
        Background="{StaticResource BgBrush}"
        MinWidth="1000" MinHeight="640"
        Width="1400" Height="880"
        Topmost="{Binding AlwaysOnTop}"
        Activated="Window_Activated" PreviewKeyDown="Window_PreviewKeyDown" Closing="Window_Closing">
    <Window.Resources>
        <app:BoolToVisibilityConverter x:Key="Vis"/>
        <DataTemplate DataType="{x:Type vm:ShowViewModel}">
            <views:ShowView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:EditViewModel}">
            <views:EditView/>
        </DataTemplate>
        <DataTemplate x:Key="SetlistSongTemplate" DataType="{x:Type vm:SetlistSongItem}">
            <Border x:Name="Chip" Margin="0,0,6,0" Padding="12,5" CornerRadius="7" BorderThickness="2" BorderBrush="{StaticResource LineBrush}" Background="{StaticResource Panel2Brush}"
                    Cursor="Hand" MouseLeftButtonDown="SetlistSong_MouseLeftButtonDown" ToolTip="{Binding Detail}">
                <TextBlock Text="{Binding Title}" FontSize="14" x:Name="ChipText"/>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsUnknown}" Value="True">
                    <Setter TargetName="ChipText" Property="Foreground" Value="{StaticResource MutedBrush}"/>
                    <Setter TargetName="ChipText" Property="FontStyle" Value="Italic"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsAvailable}" Value="False">
                    <Setter TargetName="ChipText" Property="Foreground" Value="{StaticResource MutedBrush}"/>
                    <Setter TargetName="ChipText" Property="TextDecorations" Value="Strikethrough"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter TargetName="Chip" Property="Background" Value="{StaticResource SelectBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                    <Setter TargetName="Chip" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                    <Setter TargetName="ChipText" Property="FontWeight" Value="Bold"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </Window.Resources>
    <DockPanel Margin="10">
        <!-- ===== status bar ===== -->
        <Border DockPanel.Dock="Top" Style="{StaticResource Panel}" Padding="10,6">
            <DockPanel>
                <Ellipse DockPanel.Dock="Left" Width="14" Height="14" Fill="{Binding LightBrush}" Margin="0,0,10,0" VerticalAlignment="Center"/>
                <TextBlock DockPanel.Dock="Left" Text="{Binding ConnectionText}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                <TextBlock DockPanel.Dock="Left" Text="{Binding HostText}" Foreground="{StaticResource MutedBrush}" Margin="12,0,0,0" VerticalAlignment="Center"/>

                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Border Background="{StaticResource Panel2Brush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="5" Padding="9,2" VerticalAlignment="Center" Margin="0,0,12,0"
                            x:Name="RoleBadge">
                        <TextBlock Text="{Binding RoleText}" FontWeight="Bold" FontSize="12"/>
                    </Border>
                    <Button Content="{Binding ModeButtonText}" Style="{StaticResource PrimaryButton}" MinHeight="28" MinWidth="150" FontSize="12" Command="{Binding ToggleModeCommand}"/>
                    <Button Content="Setlists" MinHeight="28" FontSize="12" Margin="6,0,0,0" Command="{Binding OpenSetlistsCommand}"/>
                    <Button Content="Settings" MinHeight="28" FontSize="12" Margin="6,0,0,0" Command="{Binding OpenSettingsCommand}"/>
                    <Button Content="Log" MinHeight="28" FontSize="12" Margin="6,0,0,0" Command="{Binding OpenLogCommand}"/>
                </StackPanel>

                <TextBlock Text="{Binding MessageText}" Foreground="{Binding MessageBrush}" Margin="18,0,12,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
            </DockPanel>
        </Border>

        <!-- ===== setlist bar (Show mode) ===== -->
        <Border DockPanel.Dock="Top" Style="{StaticResource Panel}" Padding="10,6" DataContext="{Binding Show}"
                Visibility="{Binding DataContext.IsShowMode, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource Vis}}">
            <DockPanel>
                <TextBlock DockPanel.Dock="Left" Text="SETLIST" Style="{StaticResource SectionLabel}" Margin="0,0,10,0" VerticalAlignment="Center"/>
                <ComboBox DockPanel.Dock="Left" ItemsSource="{Binding SetlistNames}" SelectedItem="{Binding ActiveSetlistName}" Width="230" MinHeight="30"/>
                <Button DockPanel.Dock="Left" Content="Manage…" MinHeight="30" FontSize="12" Margin="6,0,12,0" Command="{Binding ManageSetlistsCommand}"/>
                <Button DockPanel.Dock="Right" Content="▶ Launch (Enter)" Style="{StaticResource PrimaryButton}" MinHeight="30" FontSize="12" Margin="10,0,0,0"
                        Command="{Binding LaunchSelectedCommand}" IsEnabled="{Binding CanLaunch}"
                        ToolTip="Connects the selected song's clip. Only when 'Launch songs from setlist' is on in Settings. ←/→ select."/>
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Focusable="False">
                    <ItemsControl ItemsSource="{Binding SetlistSongs}" ItemTemplate="{StaticResource SetlistSongTemplate}" Focusable="False">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <ContentControl Content="{Binding CurrentView}" Focusable="False"/>
    </DockPanel>
</Window>
