<Window x:Class="SegmentDeck.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:app="clr-namespace:SegmentDeck.App"
        xmlns:vm="clr-namespace:SegmentDeck.App.ViewModels"
        xmlns:views="clr-namespace:SegmentDeck.App.Views"
        Title="Segment Deck"
        Background="{StaticResource BgBrush}"
        MinWidth="1000" MinHeight="640"
        Width="1400" Height="880"
        Topmost="{Binding AlwaysOnTop}"
        Activated="Window_Activated" PreviewKeyDown="Window_PreviewKeyDown" Closing="Window_Closing">
    <Window.Resources>
        <app:BoolToVisibilityConverter x:Key="Vis"/>
        <DataTemplate DataType="{x:Type vm:ShowViewModel}">
            <views:ShowView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:EditViewModel}">
            <views:EditView/>
        </DataTemplate>
        <DataTemplate x:Key="SetlistSongTemplate" DataType="{x:Type vm:SetlistSongItem}">
            <Border x:Name="Chip" Margin="0,0,6,0" Padding="10,3" CornerRadius="7" BorderThickness="2" BorderBrush="{StaticResource LineBrush}" Background="{StaticResource Panel2Brush}"
                    Cursor="Hand" MouseLeftButtonDown="SetlistSong_MouseLeftButtonDown" ToolTip="{Binding Detail}">
                <TextBlock Text="{Binding Title}" FontSize="13" x:Name="ChipText"/>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsUnknown}" Value="True">
                    <Setter TargetName="ChipText" Property="Foreground" Value="{StaticResource MutedBrush}"/>
                    <Setter TargetName="ChipText" Property="FontStyle" Value="Italic"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsAvailable}" Value="False">
                    <Setter TargetName="ChipText" Property="Foreground" Value="{StaticResource MutedBrush}"/>
                    <Setter TargetName="ChipText" Property="TextDecorations" Value="Strikethrough"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter TargetName="Chip" Property="Background" Value="{StaticResource SelectBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                    <Setter TargetName="Chip" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                    <Setter TargetName="ChipText" Property="FontWeight" Value="Bold"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </Window.Resources>
    <DockPanel Margin="10">
        <!-- ===== the one top bar: connection, setlist (Show mode), warnings, role, pin, mode and windows ===== -->
        <Border DockPanel.Dock="Top" Style="{StaticResource Panel}" Padding="10,6">
            <DockPanel>
                <Ellipse DockPanel.Dock="Left" Width="14" Height="14" Fill="{Binding LightBrush}" Margin="0,0,8,0" VerticalAlignment="Center"
                         ToolTip="{Binding HostText}"/>
                <TextBlock DockPanel.Dock="Left" Text="{Binding ConnectionText}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,14,0"
                           ToolTip="{Binding HostText}"/>

                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Border Background="{StaticResource Panel2Brush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="5" Padding="9,2" VerticalAlignment="Center" Margin="0,0,10,0"
                            x:Name="RoleBadge">
                        <TextBlock Text="{Binding RoleText}" FontWeight="Bold" FontSize="12"/>
                    </Border>
                    <ToggleButton Style="{StaticResource PinButton}" IsChecked="{Binding AlwaysOnTop}" MinHeight="28" FontSize="12" Margin="0,0,10,0"
                                  ToolTip="Keep Segment Deck above Resolume and other windows when you click away from it">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📌" Margin="0,0,5,0"/>
                            <TextBlock Text="{Binding PinText}"/>
                        </StackPanel>
                    </ToggleButton>
                    <Button Content="{Binding ModeButtonText}" Style="{StaticResource PrimaryButton}" MinHeight="28" MinWidth="150" FontSize="12" Command="{Binding ToggleModeCommand}"/>
                    <Button Content="Setlists" MinHeight="28" FontSize="12" Margin="6,0,0,0" Command="{Binding OpenSetlistsCommand}"/>
                    <Button Content="Settings" MinHeight="28" FontSize="12" Margin="6,0,0,0" Command="{Binding OpenSettingsCommand}"/>
                    <Button Content="Log" MinHeight="28" FontSize="12" Margin="6,0,0,0" Command="{Binding OpenLogCommand}"/>
                </StackPanel>

                <TextBlock DockPanel.Dock="Right" Text="{Binding MessageText}" Foreground="{Binding MessageBrush}" Margin="12,0,12,0" MaxWidth="420"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding MessageText}"/>

                <!-- setlist: dropdown and the songs in order; the whole group hides in Edit mode -->
                <DockPanel DataContext="{Binding Show}" Visibility="{Binding DataContext.IsShowMode, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource Vis}}">
                    <ComboBox DockPanel.Dock="Left" ItemsSource="{Binding SetlistNames}" SelectedItem="{Binding ActiveSetlistName}" Width="210" MinHeight="28" VerticalAlignment="Center" Margin="0,0,10,0"
                              ToolTip="Active setlist. Manage them with the Setlists button."/>
                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Focusable="False" VerticalAlignment="Center">
                        <ItemsControl ItemsSource="{Binding SetlistSongs}" ItemTemplate="{StaticResource SetlistSongTemplate}" Focusable="False">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </DockPanel>
        </Border>

        <ContentControl Content="{Binding CurrentView}" Focusable="False"/>
    </DockPanel>
</Window>
