<Window x:Class="SegmentDeck.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:app="clr-namespace:SegmentDeck.App"
        xmlns:vm="clr-namespace:SegmentDeck.App.ViewModels"
        xmlns:views="clr-namespace:SegmentDeck.App.Views"
        Title="Segment Deck"
        Background="{StaticResource BgBrush}"
        MinWidth="1000" MinHeight="640"
        Width="1400" Height="880"
        Topmost="{Binding AlwaysOnTop}"
        Activated="Window_Activated" PreviewKeyDown="Window_PreviewKeyDown" Closing="Window_Closing">
    <Window.Resources>
        <app:BoolToVisibilityConverter x:Key="Vis"/>
        <DataTemplate DataType="{x:Type vm:ShowViewModel}">
            <views:ShowView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:EditViewModel}">
            <views:EditView/>
        </DataTemplate>
    </Window.Resources>
    <DockPanel Margin="10">
        <!-- ===== status bar ===== -->
        <Border DockPanel.Dock="Top" Style="{StaticResource Panel}" Padding="10,6">
            <DockPanel>
                <Ellipse DockPanel.Dock="Left" Width="14" Height="14" Fill="{Binding LightBrush}" Margin="0,0,10,0" VerticalAlignment="Center"/>
                <TextBlock DockPanel.Dock="Left" Text="{Binding ConnectionText}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                <TextBlock DockPanel.Dock="Left" Text="{Binding HostText}" Foreground="{StaticResource MutedBrush}" Margin="12,0,0,0" VerticalAlignment="Center"/>

                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Border Background="{StaticResource Panel2Brush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="5" Padding="9,2" VerticalAlignment="Center" Margin="0,0,12,0"
                            x:Name="RoleBadge">
                        <TextBlock Text="{Binding RoleText}" FontWeight="Bold" FontSize="12"/>
                    </Border>
                    <Button Content="Edit (E)" MinHeight="28" FontSize="12" Command="{Binding ToggleModeCommand}" Visibility="{Binding IsShowMode, Converter={StaticResource Vis}}"/>
                    <Button Content="Setlists" MinHeight="28" FontSize="12" Margin="6,0,0,0" Command="{Binding OpenSetlistsCommand}"/>
                    <Button Content="Settings" MinHeight="28" FontSize="12" Margin="6,0,0,0" Command="{Binding OpenSettingsCommand}"/>
                    <Button Content="Log" MinHeight="28" FontSize="12" Margin="6,0,0,0" Command="{Binding OpenLogCommand}"/>
                </StackPanel>

                <TextBlock Text="{Binding MessageText}" Foreground="{Binding MessageBrush}" Margin="18,0,12,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
            </DockPanel>
        </Border>

        <ContentControl Content="{Binding CurrentView}" Focusable="False"/>
    </DockPanel>
</Window>
