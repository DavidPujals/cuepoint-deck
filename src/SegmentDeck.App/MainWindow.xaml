<Window x:Class="SegmentDeck.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:SegmentDeck.App.ViewModels"
        Title="Segment Deck"
        Background="{StaticResource BgBrush}"
        MinWidth="1000" MinHeight="640"
        Width="1380" Height="860"
        Topmost="{Binding AlwaysOnTop}"
        Activated="Window_Activated">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="8"/>
            <RowDefinition Height="200"/>
        </Grid.RowDefinitions>

        <!-- ===== status bar ===== -->
        <Border Grid.Row="0" Style="{StaticResource Panel}">
            <DockPanel>
                <Ellipse DockPanel.Dock="Left" Width="14" Height="14" Fill="{Binding LightBrush}" Margin="0,0,10,0" VerticalAlignment="Center"/>
                <TextBlock DockPanel.Dock="Left" Text="{Binding ConnectionText}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                <TextBlock DockPanel.Dock="Left" Text="{Binding HostText}" Foreground="{StaticResource MutedBrush}" Margin="12,0,0,0" VerticalAlignment="Center"/>
                <Border DockPanel.Dock="Right" Background="{StaticResource Panel2Brush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="5" Padding="8,2" VerticalAlignment="Center">
                    <TextBlock Text="{Binding RoleText}" FontWeight="Bold" FontSize="12"/>
                </Border>
                <TextBlock Text="{Binding MessageText}" Foreground="{Binding MessageBrush}" Margin="18,0,12,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
            </DockPanel>
        </Border>

        <!-- ===== main ===== -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="2*" MinWidth="380"/>
            </Grid.ColumnDefinitions>

            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <Border Style="{StaticResource Panel}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionLabel}" Margin="0,0,0,4" Text="LIVE"/>
                            <TextBlock Text="{Binding CompositionText}" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"/>
                            <TextBlock Text="{Binding LiveLayersText}" Style="{StaticResource Mono}" Margin="0,6,0,0"/>
                            <TextBlock Text="{Binding CurrentSongText}" FontSize="20" FontWeight="SemiBold" Margin="0,10,0,0"/>
                            <TextBlock Text="{Binding PositionText}" FontFamily="Consolas" FontSize="34" FontWeight="Bold"/>
                            <TextBlock Text="{Binding TransportText}" Foreground="{StaticResource MutedBrush}" FontSize="12" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Panel}">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Top">
                                <DockPanel>
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                        <Button Content="Refresh" MinHeight="28" FontSize="12" Command="{Binding RefreshLibrary_Command}"/>
                                        <Button Content="Open folder" MinHeight="28" FontSize="12" Margin="6,0,0,0" Command="{Binding OpenLibraryFolderCommand}"/>
                                    </StackPanel>
                                    <TextBlock Style="{StaticResource SectionLabel}" Margin="0,0,0,4" Text="LIBRARY AND CLIP MATCHES"/>
                                </DockPanel>
                                <TextBlock Text="{Binding LibraryText}" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"/>
                                <ItemsControl ItemsSource="{Binding Warnings}" Margin="0,4,0,4">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding}" Foreground="{StaticResource WarnBrush}" FontSize="12" TextWrapping="Wrap"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                            <DataGrid ItemsSource="{Binding Matches}" MinHeight="120" MaxHeight="360" Margin="0,4,0,0">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Song" Binding="{Binding Title}" Width="200"/>
                                    <DataGridTextColumn Header="Clip" Binding="{Binding Clip}" Width="90"/>
                                    <DataGridTextColumn Header="Matched by" Binding="{Binding Kind}" Width="90"/>
                                    <DataGridTextColumn Header="Note" Binding="{Binding Note}" Width="220"/>
                                    <DataGridTextColumn Header="Song file" Binding="{Binding File}" Width="*"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- settings -->
            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                <Border Style="{StaticResource Panel}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionLabel}" Margin="0,0,0,4" Text="SETTINGS (this PC)"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/>
                            </Grid.RowDefinitions>
                            <Label Grid.Row="0" Content="Resolume host"/>
                            <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding Host, UpdateSourceTrigger=PropertyChanged}" Margin="0,3"/>
                            <Label Grid.Row="1" Content="Port"/>
                            <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Port, UpdateSourceTrigger=PropertyChanged}" Width="80" HorizontalAlignment="Left" Margin="0,3"/>
                            <Label Grid.Row="2" Content="Role"/>
                            <ComboBox Grid.Row="2" Grid.Column="1" SelectedIndex="{Binding RoleIndex}" Width="160" HorizontalAlignment="Left" Margin="0,3">
                                <ComboBoxItem Content="Controller"/>
                                <ComboBoxItem Content="Follow (read-only)"/>
                            </ComboBox>
                            <Label Grid.Row="3" Content="Library path"/>
                            <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding LibraryPath, UpdateSourceTrigger=PropertyChanged}" Margin="0,3"/>
                            <Label Grid.Row="4" Content="Song layer"/>
                            <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding SongLayer, UpdateSourceTrigger=PropertyChanged}" Width="60" HorizontalAlignment="Left" Margin="0,3"/>
                            <Label Grid.Row="5" Content="Latency offset (ms)"/>
                            <TextBox Grid.Row="5" Grid.Column="1" Text="{Binding LatencyOffset, UpdateSourceTrigger=PropertyChanged}" Width="60" HorizontalAlignment="Left" Margin="0,3" ToolTip="Stored per Resolume host"/>
                            <Label Grid.Row="6" Content="Always on top"/>
                            <CheckBox Grid.Row="6" Grid.Column="1" IsChecked="{Binding AlwaysOnTop}" Margin="0,3"/>
                        </Grid>
                        <TextBlock Style="{StaticResource SectionLabel}" Text="PATH MAPPINGS (one per line: D:\Media => \\CITY-VISUALS\Media)"/>
                        <TextBox Text="{Binding PathMappingsText, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" MinHeight="70" FontFamily="Consolas" FontSize="12" TextWrapping="NoWrap"/>
                        <Button Content="Apply and save" Style="{StaticResource PrimaryButton}" Margin="0,10,0,0" Command="{Binding ApplySettingsCommand}"/>
                        <TextBlock Margin="0,10,0,0" FontSize="11" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"
                                   Text="Stored in %AppData%\SegmentDeck\settings.json. Changing the host or library path reconnects or rescans at once. The library is rescanned every time this window regains focus."/>
                        <Button Content="Open log folder" MinHeight="28" FontSize="12" Margin="0,10,0,0" HorizontalAlignment="Left" Command="{Binding OpenLogFolderCommand}"/>
                    </StackPanel>
                </Border>
            </ScrollViewer>
        </Grid>

        <!-- ===== log ===== -->
        <DockPanel Grid.Row="3">
            <TextBlock DockPanel.Dock="Top" Style="{StaticResource SectionLabel}" Margin="2,0,0,4" Text="LOG"/>
            <ListBox x:Name="LogList" ItemsSource="{Binding LogLines}" Background="#11151A" Foreground="{StaticResource InkBrush}"
                     BorderBrush="{StaticResource LineBrush}" FontFamily="Consolas" FontSize="12"
                     ScrollViewer.HorizontalScrollBarVisibility="Auto">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="4,0"/>
                        <Setter Property="Focusable" Value="False"/>
                    </Style>
                </ListBox.ItemContainerStyle>
            </ListBox>
        </DockPanel>
    </Grid>
</Window>
