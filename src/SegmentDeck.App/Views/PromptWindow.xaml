<Window x:Class="SegmentDeck.App.Views.PromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Segment Deck" Background="{StaticResource BgBrush}"
        Width="460" SizeToContent="Height" ResizeMode="NoResize" WindowStartupLocation="CenterOwner">
    <StackPanel Margin="14">
        <TextBlock x:Name="PromptText" Margin="0,0,0,8"/>
        <TextBox x:Name="Box" FontSize="15" KeyDown="Box_KeyDown"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Cancel" MinWidth="90" Click="Cancel_Click"/>
            <Button Content="OK" Style="{StaticResource PrimaryButton}" MinWidth="90" Margin="8,0,0,0" Click="Ok_Click"/>
        </StackPanel>
    </StackPanel>
</Window>
