<Window x:Class="SegmentDeck.App.Views.DarkMessageBox"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Segment Deck" Background="{StaticResource BgBrush}"
        Width="520" SizeToContent="Height" ResizeMode="NoResize" WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <StackPanel Margin="18,16,18,14">
        <TextBlock x:Name="MessageText" FontSize="14" TextWrapping="Wrap" LineHeight="20"/>
        <StackPanel x:Name="Buttons" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0"/>
    </StackPanel>
</Window>
