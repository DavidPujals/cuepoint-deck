<Window x:Class="SegmentDeck.App.Views.LogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Segment Deck log" Background="{StaticResource BgBrush}"
        Width="1000" Height="500" WindowStartupLocation="CenterOwner">
    <DockPanel Margin="10">
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
            <Button DockPanel.Dock="Right" Content="Open log folder" MinHeight="28" FontSize="12" Click="OpenFolder_Click"/>
            <TextBlock Text="Last 400 lines. The full daily files are in %AppData%\SegmentDeck\logs." Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/>
        </DockPanel>
        <ListBox x:Name="List" Background="#11151A" Foreground="{StaticResource InkBrush}" BorderBrush="{StaticResource LineBrush}" FontFamily="Consolas" FontSize="12"
                 ScrollViewer.HorizontalScrollBarVisibility="Auto">
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="Padding" Value="4,0"/>
                    <Setter Property="Focusable" Value="False"/>
                </Style>
            </ListBox.ItemContainerStyle>
        </ListBox>
    </DockPanel>
</Window>
