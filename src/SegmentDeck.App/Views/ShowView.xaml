<UserControl x:Class="SegmentDeck.App.Views.ShowView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:app="clr-namespace:SegmentDeck.App"
             xmlns:vm="clr-namespace:SegmentDeck.App.ViewModels"
             xmlns:ctl="clr-namespace:SegmentDeck.App.Controls"
             Focusable="False">
    <UserControl.Resources>
        <app:HexToBrushConverter x:Key="Hex"/>
        <app:BoolToVisibilityConverter x:Key="Vis"/>
        <app:BoolToVisibilityConverter x:Key="VisInv" Invert="True"/>
        <app:NullToVisibilityConverter x:Key="NotNullVis"/>
        <app:ScaleConverter x:Key="Scale"/>

        <!-- one segment card -->
        <DataTemplate x:Key="CardTemplate" DataType="{x:Type vm:SegmentCardViewModel}">
            <Border x:Name="Card" Margin="5" CornerRadius="9" BorderThickness="3" BorderBrush="{StaticResource LineBrush}"
                    Background="{StaticResource PanelBrush}" Cursor="Hand"
                    Width="{Binding DataContext.CardScale, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource Scale}, ConverterParameter=240}"
                    MouseLeftButtonUp="Card_MouseLeftButtonUp" ToolTip="{Binding StartText}">
                <Border.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Cut (jump now)" Command="{Binding CutCommand}"/>
                        <MenuItem Header="Queue (at end of current segment)" Command="{Binding QueueCommand}"/>
                    </ContextMenu>
                </Border.ContextMenu>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- thumbnail or placeholder -->
                    <Grid Grid.Row="0" Height="{Binding DataContext.CardScale, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource Scale}, ConverterParameter=135}" ClipToBounds="True">
                        <Border Background="{Binding ColorHex, Converter={StaticResource Hex}, ConverterParameter=0.55}" CornerRadius="6,6,0,0">
                            <TextBlock Text="{Binding Name}" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center" Margin="10" Opacity="0.9"/>
                        </Border>
                        <Border CornerRadius="6,6,0,0" Visibility="{Binding HasThumb, Converter={StaticResource Vis}}">
                            <Border.Background>
                                <ImageBrush ImageSource="{Binding Thumb}" Stretch="UniformToFill"/>
                            </Border.Background>
                        </Border>
                        <!-- number badge -->
                        <Border HorizontalAlignment="Left" VerticalAlignment="Top" Margin="6" Background="#CC000000" CornerRadius="5" Padding="7,1" Visibility="{Binding NumberLabel, Converter={StaticResource NotNullVis}}">
                            <TextBlock Text="{Binding NumberLabel}" FontSize="15" FontWeight="Bold" Foreground="White"/>
                        </Border>
                        <!-- queued -->
                        <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="6" Background="#DD000000" CornerRadius="5" Padding="7,2" Visibility="{Binding IsQueued, Converter={StaticResource Vis}}">
                            <TextBlock Text="{Binding QueueText}" FontSize="13" FontWeight="Bold" Foreground="{StaticResource WarnBrush}"/>
                        </Border>
                        <!-- next marker -->
                        <Border HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="6" Background="#99000000" CornerRadius="4" Padding="6,1" Visibility="{Binding IsNext, Converter={StaticResource Vis}}">
                            <TextBlock Text="next" FontSize="11" Foreground="{StaticResource MutedBrush}"/>
                        </Border>
                    </Grid>

                    <!-- colour stripe + name -->
                    <DockPanel Grid.Row="1" Margin="0,6,0,0">
                        <Rectangle DockPanel.Dock="Left" Width="6" Margin="8,0,0,0" RadiusX="2" RadiusY="2" Fill="{Binding ColorHex, Converter={StaticResource Hex}}"/>
                        <TextBlock Text="{Binding Name}" FontSize="19" FontWeight="SemiBold" Margin="8,0,8,0" TextTrimming="CharacterEllipsis"/>
                    </DockPanel>
                    <TextBlock Grid.Row="2" Text="{Binding Lyric}" FontSize="13" Foreground="{StaticResource MutedBrush}" Margin="22,2,8,6" TextTrimming="CharacterEllipsis" MaxHeight="36" TextWrapping="Wrap"/>

                    <!-- segment progress -->
                    <ProgressBar Grid.Row="3" Height="5" Minimum="0" Maximum="1" Value="{Binding Progress, Mode=OneWay}" Margin="8,0,8,7"
                                 Background="#11151A" BorderThickness="0" Foreground="{Binding ColorHex, Converter={StaticResource Hex}}"/>
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsLive}" Value="True">
                    <Setter TargetName="Card" Property="BorderBrush" Value="{Binding ColorHex, Converter={StaticResource Hex}}"/>
                    <Setter TargetName="Card" Property="Background" Value="{Binding ColorHex, Converter={StaticResource Hex}, ConverterParameter=0.22}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsQueued}" Value="True">
                    <Setter TargetName="Card" Property="BorderBrush" Value="{StaticResource WarnBrush}"/>
                    <DataTrigger.EnterActions>
                        <BeginStoryboard x:Name="Pulse">
                            <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                <DoubleAnimation Storyboard.TargetName="Card" Storyboard.TargetProperty="BorderBrush.Opacity" From="1" To="0.25" Duration="0:0:0.6"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </DataTrigger.EnterActions>
                    <DataTrigger.ExitActions>
                        <StopStoryboard BeginStoryboardName="Pulse"/>
                    </DataTrigger.ExitActions>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsFlashing}" Value="True">
                    <Setter TargetName="Card" Property="BorderBrush" Value="{StaticResource DangerBrush}"/>
                    <Setter TargetName="Card" Property="Background" Value="#55FF453A"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding DataContext.CanFire, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="False">
                    <Setter TargetName="Card" Property="Opacity" Value="0.45"/>
                    <Setter TargetName="Card" Property="Cursor" Value="Arrow"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <DataTemplate x:Key="SetlistSongTemplate" DataType="{x:Type vm:SetlistSongItem}">
            <Border x:Name="Chip" Margin="0,0,6,0" Padding="12,6" CornerRadius="7" BorderThickness="2" BorderBrush="{StaticResource LineBrush}" Background="{StaticResource Panel2Brush}"
                    Cursor="Hand" MouseLeftButtonUp="SetlistSong_MouseLeftButtonUp" MouseLeftButtonDown="SetlistSong_MouseLeftButtonDown" ToolTip="{Binding Detail}">
                <TextBlock Text="{Binding Title}" FontSize="14" x:Name="ChipText"/>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsUnknown}" Value="True">
                    <Setter TargetName="ChipText" Property="Foreground" Value="{StaticResource MutedBrush}"/>
                    <Setter TargetName="ChipText" Property="FontStyle" Value="Italic"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsAvailable}" Value="False">
                    <Setter TargetName="ChipText" Property="Foreground" Value="{StaticResource MutedBrush}"/>
                    <Setter TargetName="ChipText" Property="TextDecorations" Value="Strikethrough"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter TargetName="Chip" Property="Background" Value="{StaticResource SelectBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                    <Setter TargetName="Chip" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                    <Setter TargetName="ChipText" Property="FontWeight" Value="Bold"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ===== current song ===== -->
        <Border Grid.Row="0" Style="{StaticResource Panel}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="Add to library" Style="{StaticResource PrimaryButton}" MinHeight="30" FontSize="12"
                                Command="{Binding AddUnknownClipCommand}" Visibility="{Binding IsUnknownClip, Converter={StaticResource Vis}}"/>
                        <TextBlock Text="{Binding SongTitle}" FontSize="26" FontWeight="Bold" TextTrimming="CharacterEllipsis"/>
                    </DockPanel>
                    <TextBlock Text="{Binding SongSubtitle}" Foreground="{StaticResource MutedBrush}" FontSize="12" TextTrimming="CharacterEllipsis"/>
                    <Grid Margin="0,8,0,2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{Binding ElapsedText}" FontFamily="Consolas" FontSize="22" FontWeight="Bold" Margin="0,0,10,0" VerticalAlignment="Center"/>
                        <ctl:SegmentProgressBar Grid.Column="1" Height="14" VerticalAlignment="Center" Progress="{Binding ClipProgress}" Ticks="{Binding Ticks}" TickColors="{Binding TickColors}" Fill="{Binding ProgressFill}"/>
                        <TextBlock Grid.Column="2" Text="{Binding RemainingText}" FontFamily="Consolas" FontSize="22" FontWeight="Bold" Margin="10,0,0,0" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}"/>
                    </Grid>
                </StackPanel>
                <StackPanel Grid.Column="1" VerticalAlignment="Top" Margin="14,0,0,0" HorizontalAlignment="Right">
                    <TextBlock Text="{Binding CannotFireReason}" Foreground="{StaticResource WarnBrush}" FontWeight="Bold" FontSize="14" HorizontalAlignment="Right" Visibility="{Binding CannotFireReason, Converter={StaticResource NotNullVis}}"/>
                    <TextBlock Text="{Binding DefaultTriggerHint}" Foreground="{StaticResource MutedBrush}" FontSize="11" HorizontalAlignment="Right" Margin="0,4,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ===== cards ===== -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Focusable="False">
            <Grid>
                <ItemsControl ItemsSource="{Binding Cards}" ItemTemplate="{StaticResource CardTemplate}" Focusable="False">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
                <TextBlock Text="No segments to show. Pick a song in Resolume, or press E to build one in Edit mode."
                           Foreground="{StaticResource MutedBrush}" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="40"
                           Visibility="{Binding HasSong, Converter={StaticResource VisInv}}"/>
            </Grid>
        </ScrollViewer>

        <!-- ===== setlist strip ===== -->
        <Border Grid.Row="2" Style="{StaticResource Panel}" Margin="0,8,0,0" Padding="10,6">
            <DockPanel>
                <Button DockPanel.Dock="Left" Content="Setlist ▾" MinHeight="30" FontSize="12" Command="{Binding ToggleSetlistCommand}" Margin="0,0,8,0"/>
                <ComboBox DockPanel.Dock="Left" ItemsSource="{Binding SetlistNames}" SelectedItem="{Binding ActiveSetlistName}" Width="220" MinHeight="30"
                          Visibility="{Binding IsSetlistVisible, Converter={StaticResource Vis}}"/>
                <Button DockPanel.Dock="Left" Content="Manage…" MinHeight="30" FontSize="12" Margin="6,0,10,0" Command="{Binding ManageSetlistsCommand}"
                        Visibility="{Binding IsSetlistVisible, Converter={StaticResource Vis}}"/>
                <Button DockPanel.Dock="Right" Content="▶ Launch (Enter)" Style="{StaticResource PrimaryButton}" MinHeight="30" FontSize="12"
                        Command="{Binding LaunchSelectedCommand}" IsEnabled="{Binding CanLaunch}" Visibility="{Binding IsSetlistVisible, Converter={StaticResource Vis}}"
                        ToolTip="Connects the selected song's clip. Only when 'Launch songs from setlist' is on in Settings."/>
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Visibility="{Binding IsSetlistVisible, Converter={StaticResource Vis}}" Focusable="False">
                    <ItemsControl ItemsSource="{Binding SetlistSongs}" ItemTemplate="{StaticResource SetlistSongTemplate}" Focusable="False">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
