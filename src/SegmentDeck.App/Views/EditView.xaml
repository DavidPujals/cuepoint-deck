<UserControl x:Class="SegmentDeck.App.Views.EditView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:app="clr-namespace:SegmentDeck.App"
             xmlns:ctl="clr-namespace:SegmentDeck.App.Controls"
             xmlns:vm="clr-namespace:SegmentDeck.App.ViewModels"
             Focusable="False">
    <UserControl.Resources>
        <app:HexToBrushConverter x:Key="Hex"/>
        <app:BoolToVisibilityConverter x:Key="Vis"/>
        <app:BoolToVisibilityConverter x:Key="VisInv" Invert="True"/>
        <app:NullToVisibilityConverter x:Key="NotNullVis"/>
        <app:NullToVisibilityConverter x:Key="NullVis" Invert="True"/>
        <app:ImageAspectConverter x:Key="Aspect"/>
        <app:AtLeastConverter x:Key="AtLeast"/>
        <Style x:Key="SmallButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="MinHeight" Value="28"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="8,2"/>
        </Style>
        <Style x:Key="TimeBox" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Width" Value="118"/>
        </Style>
    </UserControl.Resources>

    <!-- The page is exactly the size of the window's content area, so the segment list and filmstrip scroll inside
         their own panels. Only below about 1360x720 of content does the whole page scroll, rather than crushing the panels. -->
    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Focusable="False">
    <Grid Width="{Binding ViewportWidth, RelativeSource={RelativeSource AncestorType=ScrollViewer}, Converter={StaticResource AtLeast}, ConverterParameter=1360}"
          Height="{Binding ViewportHeight, RelativeSource={RelativeSource AncestorType=ScrollViewer}, Converter={StaticResource AtLeast}, ConverterParameter=720}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250"/>
            <ColumnDefinition Width="10"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="10"/>
            <ColumnDefinition Width="420"/>
        </Grid.ColumnDefinitions>

        <!-- ===== left: songs ===== -->
        <Border Grid.Column="0" Style="{StaticResource Panel}" Margin="0">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Style="{StaticResource SectionLabel}" Margin="0,0,0,4" Text="EDIT MODE — never sends to Resolume"/>
                <StackPanel DockPanel.Dock="Top">
                    <Button Content="New song from composition…" Command="{Binding NewFromCompositionCommand}" Margin="0,0,0,4" MinHeight="30" FontSize="12"/>
                    <Button Content="New song from a file…" Command="{Binding NewFromFileCommand}" Margin="0,0,0,4" MinHeight="30" FontSize="12"/>
                    <Button Content="Setlists…" Command="{Binding OpenSetlistsCommand}" Margin="0,0,0,8" MinHeight="30" FontSize="12"
                            ToolTip="Create, rename and order the setlists shown in the top bar in Show mode"/>
                </StackPanel>
                <Button DockPanel.Dock="Bottom" Content="Open library folder" Style="{StaticResource SmallButton}" Margin="0,8,0,0" Command="{Binding OpenLibraryFolderCommand}"/>
                <TextBlock DockPanel.Dock="Top" Style="{StaticResource SectionLabel}" Text="LIBRARY"/>
                <ListBox ItemsSource="{Binding Songs}" SelectedItem="{Binding SelectedSongItem}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="2">
                                <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding Detail}" FontSize="11" Foreground="{StaticResource MutedBrush}" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- ===== middle: song + segments ===== -->
        <Grid Grid.Column="2" Visibility="{Binding HasSong, Converter={StaticResource Vis}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Style="{StaticResource Panel}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="200"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition/><RowDefinition/><RowDefinition/>
                    </Grid.RowDefinitions>
                    <Label Grid.Row="0" Content="Title"/>
                    <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}" FontSize="16" Margin="0,2"/>
                    <Label Grid.Row="0" Grid.Column="2" Content="Artist" Margin="12,0,0,0"/>
                    <TextBox Grid.Row="0" Grid.Column="3" Text="{Binding Artist, UpdateSourceTrigger=PropertyChanged}" Margin="0,2"/>
                    <Label Grid.Row="1" Content="File"/>
                    <TextBlock Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3" Text="{Binding ClipFileText}" Foreground="{StaticResource MutedBrush}" FontSize="12" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                    <Label Grid.Row="2" Content="Status"/>
                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding ClipStatusText}" Foreground="{StaticResource MutedBrush}" FontSize="12" VerticalAlignment="Center"/>
                    <Label Grid.Row="2" Grid.Column="2" Content="Duration" Margin="12,0,0,0"/>
                    <TextBlock Grid.Row="2" Grid.Column="3" Text="{Binding DurationText}" FontFamily="Consolas" VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <Border Grid.Row="1" Style="{StaticResource Panel}">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button Content="Suggest" Style="{StaticResource SmallButton}" MinHeight="30" Margin="0,0,6,0" Command="{Binding SuggestSegmentsCommand}"
                                    ToolTip="Analyses the audio and the video cuts on this PC, adds draft segments, and reads their lyric notes off the video. No internet, no outside service."/>
                            <Button Content="Read lyrics" Style="{StaticResource SmallButton}" MinHeight="30" Margin="0,0,6,0" Command="{Binding ReadLyricsFromVideoCommand}"
                                    ToolTip="Fills empty lyric notes with the on-screen text just after each segment starts, using the OCR built into Windows."/>
                            <Button Content="Mark at playhead (M)" Style="{StaticResource PrimaryButton}" MinHeight="30" FontSize="12" Command="{Binding MarkAtPlayheadCommand}" IsEnabled="{Binding PlayheadAvailable}"/>
                            <Button Content="Mark at preview (⇧M)" Style="{StaticResource SmallButton}" MinHeight="30" Margin="6,0,0,0" Command="{Binding MarkAtScrubberCommand}" IsEnabled="{Binding ScrubberAvailable}"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource SectionLabel}" Margin="0,0,10,0" Text="SEGMENTS" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding PlayheadText}" FontFamily="Consolas" FontSize="18" FontWeight="Bold" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding PlayheadHint}" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="8,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="0,6,0,0" Visibility="{Binding SuggestStatus, Converter={StaticResource NotNullVis}}">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Visibility="{Binding HasDrafts, Converter={StaticResource Vis}}">
                            <Button Content="Keep drafts" Style="{StaticResource SmallButton}" Command="{Binding AcceptDraftsCommand}"/>
                            <Button Content="Discard drafts" Style="{StaticResource DangerButton}" MinHeight="28" FontSize="12" Margin="6,0,0,0" Command="{Binding DiscardDraftsCommand}"/>
                        </StackPanel>
                        <TextBlock Text="{Binding SuggestStatus}" FontSize="12" Foreground="{StaticResource WarnBrush}" VerticalAlignment="Center" TextWrapping="Wrap"/>
                    </DockPanel>
                    <ListBox ItemsSource="{Binding Segments}" SelectedItem="{Binding SelectedSegment}" Margin="0,6,0,0"
                             HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:SegmentEditItem}">
                                <Grid Margin="2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <!-- 16:9 gives 96x54; a wide canvas grows to 200 px across so it stays readable -->
                                    <ctl:AspectBox Grid.Column="0" MaxHeight="54" MaxWidth="200" Ratio="{Binding Thumb, Converter={StaticResource Aspect}}" VerticalAlignment="Center">
                                        <Grid>
                                            <Border Background="{Binding Color, Converter={StaticResource Hex}, ConverterParameter=0.6}" CornerRadius="4"/>
                                            <Image Source="{Binding Thumb}" Stretch="Uniform" Visibility="{Binding Thumb, Converter={StaticResource NotNullVis}}"/>
                                        </Grid>
                                    </ctl:AspectBox>
                                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding RangeText}" FontFamily="Consolas" FontSize="13" Foreground="{StaticResource MutedBrush}"/>
                                            <Rectangle DockPanel.Dock="Left" Width="5" Height="16" RadiusX="2" RadiusY="2" Fill="{Binding Color, Converter={StaticResource Hex}}" Margin="0,0,6,0"/>
                                            <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold"/>
                                        </DockPanel>
                                        <TextBlock Text="{Binding Lyric}" FontSize="12" Foreground="{StaticResource MutedBrush}" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding ThumbStatus}" FontSize="10" Foreground="{StaticResource WarnBrush}" Visibility="{Binding ThumbStatus, Converter={StaticResource NotNullVis}}"/>
                                        <TextBlock Text="{Binding DraftText}" FontSize="10" FontStyle="Italic" Foreground="{StaticResource AccentBrush}" Visibility="{Binding IsDraft, Converter={StaticResource Vis}}"/>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <!-- selected segment editor -->
            <Border Grid.Row="2" Style="{StaticResource Panel}" Margin="0">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionLabel}" Margin="0,0,0,4" Text="SELECTED SEGMENT"/>
                    <Grid DataContext="{Binding SelectedSegment}" Visibility="{Binding Converter={StaticResource NotNullVis}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/>
                        </Grid.RowDefinitions>
                        <Label Grid.Row="0" Content="Name"/>
                        <DockPanel Grid.Row="0" Grid.Column="1" Margin="0,2">
                            <TextBlock DockPanel.Dock="Right" Text="any name works, e.g. Bridge 2 or Big Chorus" FontSize="11" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="10,0,0,0"/>
                            <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" FontSize="15" ToolTip="Type any label. The buttons below are just quick picks."/>
                        </DockPanel>

                        <Label Grid.Row="1" Content="Start"/>
                        <WrapPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="0,2">
                            <TextBox Style="{StaticResource TimeBox}" Text="{Binding StartText, UpdateSourceTrigger=LostFocus}" ToolTip="hh:mm:ss:ff at the clip's frame rate"/>
                            <Button Content="−1 fr" Style="{StaticResource SmallButton}" Margin="8,0,0,0" Command="{Binding DataContext.NudgeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="-frame"/>
                            <Button Content="+1 fr" Style="{StaticResource SmallButton}" Margin="4,0,0,0" Command="{Binding DataContext.NudgeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="+frame"/>
                            <Button Content="−100 ms" Style="{StaticResource SmallButton}" Margin="8,0,0,0" Command="{Binding DataContext.NudgeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="-100"/>
                            <Button Content="+100 ms" Style="{StaticResource SmallButton}" Margin="4,0,0,0" Command="{Binding DataContext.NudgeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="+100"/>
                            <Button Content="= playhead" Style="{StaticResource SmallButton}" Margin="8,0,0,0" Command="{Binding DataContext.SetStartFromPlayheadCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" IsEnabled="{Binding DataContext.PlayheadAvailable, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                            <Button Content="= preview" Style="{StaticResource SmallButton}" Margin="4,0,0,0" Command="{Binding DataContext.SetStartFromScrubberCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                            <Button Content="Preview → here" Style="{StaticResource SmallButton}" Margin="8,0,0,0" Command="{Binding DataContext.SeekScrubberToSegmentCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                        </WrapPanel>

                        <Label Grid.Row="2" Content="End"/>
                        <WrapPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Margin="0,2">
                            <TextBox Style="{StaticResource TimeBox}" Text="{Binding EndText, UpdateSourceTrigger=LostFocus}" ToolTip="Optional. Leave empty and the segment runs until the next one starts. Set it to leave a gap that belongs to no segment."/>
                            <Button Content="−1 fr" Style="{StaticResource SmallButton}" Margin="8,0,0,0" Command="{Binding DataContext.NudgeEndCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="-frame" IsEnabled="{Binding HasEnd}"/>
                            <Button Content="+1 fr" Style="{StaticResource SmallButton}" Margin="4,0,0,0" Command="{Binding DataContext.NudgeEndCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="+frame" IsEnabled="{Binding HasEnd}"/>
                            <Button Content="= playhead" Style="{StaticResource SmallButton}" Margin="8,0,0,0" Command="{Binding DataContext.SetEndFromPlayheadCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" IsEnabled="{Binding DataContext.PlayheadAvailable, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                            <Button Content="= preview" Style="{StaticResource SmallButton}" Margin="4,0,0,0" Command="{Binding DataContext.SetEndFromScrubberCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                            <Button Content="Preview → end" Style="{StaticResource SmallButton}" Margin="8,0,0,0" Command="{Binding DataContext.SeekScrubberToEndCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" IsEnabled="{Binding HasEnd}"/>
                            <Button Content="Clear end" Style="{StaticResource SmallButton}" Margin="8,0,0,0" Command="{Binding DataContext.ClearEndCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" IsEnabled="{Binding HasEnd}"/>
                            <TextBlock Text="runs until the next segment" FontSize="11" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="10,0,0,0" Visibility="{Binding HasEnd, Converter={StaticResource VisInv}}"/>
                        </WrapPanel>

                        <Label Grid.Row="3" Content="Lyric"/>
                        <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding Lyric, UpdateSourceTrigger=PropertyChanged}" Margin="0,2" AcceptsReturn="True" MaxLines="2" ToolTip="One or two lines the operator sees on the card"/>
                        <Label Grid.Row="4" Content="Colour"/>
                        <ItemsControl Grid.Row="4" Grid.Column="1" ItemsSource="{Binding DataContext.PaletteList, RelativeSource={RelativeSource AncestorType=UserControl}}" Margin="0,4">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Width="30" Height="26" Margin="0,0,5,0" Padding="0" MinHeight="0" Background="{Binding Converter={StaticResource Hex}}" BorderBrush="#66FFFFFF"
                                            Command="{Binding DataContext.SetColorCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Button Grid.Row="0" Grid.RowSpan="2" Grid.Column="2" Content="Delete segment" Style="{StaticResource DangerButton}" MinHeight="28" FontSize="12" Margin="12,0,0,0" VerticalAlignment="Top"
                                Command="{Binding DataContext.DeleteSegmentCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                    </Grid>
                    <ItemsControl ItemsSource="{Binding QuickNamesList}" Margin="0,4,0,0">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Content="{Binding}" Style="{StaticResource SmallButton}" Margin="0,0,4,4" Command="{Binding DataContext.SetNameCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <DockPanel Margin="0,6,0,0">
                        <Button DockPanel.Dock="Right" Content="Delete song" Style="{StaticResource DangerButton}" MinHeight="30" FontSize="12" Command="{Binding DeleteSongCommand}"/>
                        <Button DockPanel.Dock="Right" Content="Save (Ctrl+S)" Style="{StaticResource PrimaryButton}" MinWidth="140" Margin="0,0,8,0" Command="{Binding SaveCommand}"/>
                        <Button DockPanel.Dock="Right" Content="Render thumbnails" Style="{StaticResource SmallButton}" MinHeight="30" Margin="0,0,8,0" Command="{Binding RenderThumbnailsCommand}"
                                ToolTip="Renders the first frame of every segment that has no thumbnail or whose start time changed"/>
                        <TextBlock Text="{Binding SaveStatusText}" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                    </DockPanel>
                </StackPanel>
            </Border>
        </Grid>
        <TextBlock Grid.Column="2" Text="Pick a song on the left, or create one from the composition or a file." Foreground="{StaticResource MutedBrush}" FontSize="16"
                   HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding HasSong, Converter={StaticResource VisInv}}"/>

        <!-- ===== right: preview player ===== -->
        <Border Grid.Column="4" Style="{StaticResource Panel}" Margin="0" Visibility="{Binding HasSong, Converter={StaticResource Vis}}">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Style="{StaticResource SectionLabel}" Margin="0,0,0,4" Text="PREVIEW — follows the selected segment's start and end"/>
                <TextBlock DockPanel.Dock="Top" Text="{Binding SourceFileStatus}" FontSize="11" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,0,0,6"/>
                <!-- height follows the clip's shape: a 16:9 song is 16:9 here, a 2688x512 canvas is a wide strip -->
                <Border DockPanel.Dock="Top" Background="Black" CornerRadius="6" ClipToBounds="True">
                    <ctl:AspectBox Ratio="{Binding PreviewAspect}">
                    <Grid>
                        <Image Source="{Binding PreviewImage}" Stretch="Uniform" Visibility="{Binding ProxyPath, Converter={StaticResource NullVis}}"/>
                        <MediaElement x:Name="Player" LoadedBehavior="Manual" UnloadedBehavior="Manual" ScrubbingEnabled="True" Stretch="Uniform"
                                      Visibility="{Binding ProxyPath, Converter={StaticResource NotNullVis}}"
                                      MediaOpened="Player_MediaOpened" MediaEnded="Player_MediaEnded" MediaFailed="Player_MediaFailed"
                                      MouseLeftButtonUp="Player_MouseLeftButtonUp"/>
                    </Grid>
                    </ctl:AspectBox>
                </Border>
                <DockPanel DockPanel.Dock="Top" Margin="0,6,0,0">
                    <Button DockPanel.Dock="Left" Content="{Binding PlayPauseText}" Style="{StaticResource PrimaryButton}" MinWidth="96" MinHeight="32" Command="{Binding PlayPauseCommand}" ToolTip="Space"/>
                    <Button DockPanel.Dock="Right" Content="▶|" Style="{StaticResource SmallButton}" MinHeight="32" Width="40" Click="StepForward_Click" ToolTip="Next frame (→)"/>
                    <Button DockPanel.Dock="Right" Content="|◀" Style="{StaticResource SmallButton}" MinHeight="32" Width="40" Margin="0,0,4,0" Click="StepBack_Click" ToolTip="Previous frame (←)"/>
                    <StackPanel VerticalAlignment="Center" Margin="10,0">
                        <TextBlock Text="{Binding ScrubText}" FontFamily="Consolas" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center"/>
                        <TextBlock Text="{Binding PreviewKind}" FontSize="10" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center"/>
                    </StackPanel>
                </DockPanel>
                <Slider DockPanel.Dock="Top" x:Name="ScrubSlider" Minimum="0" Maximum="{Binding DurationMs}" Value="{Binding ScrubMs}" IsMoveToPointEnabled="True"
                        SmallChange="{Binding FrameStepMs}" LargeChange="1000" Margin="0,4" PreviewKeyDown="ScrubSlider_PreviewKeyDown" IsEnabled="{Binding ScrubberAvailable}"
                        Thumb.DragStarted="ScrubSlider_DragStarted"/>
                <TextBlock DockPanel.Dock="Top" Text="{Binding ScrubStatus}" FontSize="11" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,0,0,6"/>
                <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
                    <ItemsControl ItemsSource="{Binding Frames}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:FilmstripFrame}">
                                <ctl:AspectBox Height="53" Margin="2" Cursor="Hand" Ratio="{Binding Image, Converter={StaticResource Aspect}}" MouseLeftButtonDown="Frame_MouseLeftButtonDown" ToolTip="{Binding TimeText}">
                                    <Grid>
                                        <Image Source="{Binding Image}" Stretch="Uniform"/>
                                        <TextBlock Text="{Binding TimeText}" FontSize="9" Foreground="White" Background="#99000000" HorizontalAlignment="Left" VerticalAlignment="Bottom" Padding="2,0"/>
                                    </Grid>
                                </ctl:AspectBox>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Border>
    </Grid>
    </ScrollViewer>
</UserControl>
