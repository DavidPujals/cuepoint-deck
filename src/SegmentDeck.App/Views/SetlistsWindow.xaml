<Window x:Class="SegmentDeck.App.Views.SetlistsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:app="clr-namespace:SegmentDeck.App"
        Title="Setlists" Background="{StaticResource BgBrush}"
        Width="900" Height="600" MinWidth="760" MinHeight="460" WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <app:BoolToVisibilityConverter x:Key="Vis"/>
        <Style x:Key="SmallButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="MinHeight" Value="28"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
    </Window.Resources>
    <Grid Margin="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240"/>
            <ColumnDefinition Width="10"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="10"/>
            <ColumnDefinition Width="260"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Style="{StaticResource Panel}" Margin="0">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Style="{StaticResource SectionLabel}" Margin="0,0,0,4" Text="SETLISTS"/>
                <UniformGrid DockPanel.Dock="Bottom" Columns="2" Margin="0,8,0,0">
                    <Button Content="New" Style="{StaticResource SmallButton}" Margin="0,0,3,3" Command="{Binding NewCommand}"/>
                    <Button Content="Rename" Style="{StaticResource SmallButton}" Margin="3,0,0,3" Command="{Binding RenameCommand}"/>
                    <Button Content="Duplicate" Style="{StaticResource SmallButton}" Margin="0,0,3,0" Command="{Binding DuplicateCommand}"/>
                    <Button Content="Delete" Style="{StaticResource DangerButton}" MinHeight="28" FontSize="12" Margin="3,0,0,0" Command="{Binding DeleteCommand}"/>
                </UniformGrid>
                <ListBox ItemsSource="{Binding Names}" SelectedItem="{Binding SelectedName}" Background="#11151A" BorderBrush="{StaticResource LineBrush}" Foreground="{StaticResource InkBrush}" FontSize="14"/>
            </DockPanel>
        </Border>

        <Border Grid.Column="2" Style="{StaticResource Panel}" Margin="0">
            <DockPanel>
                <DockPanel DockPanel.Dock="Top">
                    <Button DockPanel.Dock="Right" Content="Use in Show mode" Style="{StaticResource PrimaryButton}" MinHeight="28" FontSize="12" Command="{Binding MakeActiveCommand}"/>
                    <TextBlock DockPanel.Dock="Right" Text="ACTIVE" Foreground="{StaticResource AccentBrush}" FontWeight="Bold" Margin="0,0,10,0" VerticalAlignment="Center" Visibility="{Binding IsActive, Converter={StaticResource Vis}}"/>
                    <TextBlock Style="{StaticResource SectionLabel}" Margin="0,0,0,4" Text="SONGS IN THIS SETLIST  (drag to reorder)"/>
                </DockPanel>
                <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,8,0,0">
                    <Button Content="▲ Up" Style="{StaticResource SmallButton}" Command="{Binding MoveUpCommand}"/>
                    <Button Content="▼ Down" Style="{StaticResource SmallButton}" Margin="6,0,0,0" Command="{Binding MoveDownCommand}"/>
                    <Button Content="Remove" Style="{StaticResource SmallButton}" Margin="14,0,0,0" Command="{Binding RemoveSongCommand}"/>
                    <TextBlock Text="{Binding Status}" Foreground="{StaticResource MutedBrush}" Margin="14,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
                <ListBox x:Name="EntryList" ItemsSource="{Binding Entries}" SelectedItem="{Binding SelectedEntry}" Margin="0,6,0,0" Background="#11151A" BorderBrush="{StaticResource LineBrush}" Foreground="{StaticResource InkBrush}"
                         FontSize="15" AllowDrop="True" PreviewMouseLeftButtonDown="EntryList_PreviewMouseLeftButtonDown" PreviewMouseMove="EntryList_PreviewMouseMove" Drop="EntryList_Drop" DragOver="EntryList_DragOver">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Right" Text="{Binding Detail}" FontSize="11" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="10,0,0,0"/>
                                <TextBlock Text="{Binding Title}"/>
                            </DockPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <Border Grid.Column="4" Style="{StaticResource Panel}" Margin="0">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Style="{StaticResource SectionLabel}" Margin="0,0,0,4" Text="{Binding SourceHeader}"/>
                <Button DockPanel.Dock="Bottom" Content="◀ Add to setlist" Style="{StaticResource PrimaryButton}" Margin="0,8,0,0" Command="{Binding AddSongCommand}"/>
                <ListBox ItemsSource="{Binding Sources}" SelectedItem="{Binding SelectedSource}" Background="#11151A" BorderBrush="{StaticResource LineBrush}" Foreground="{StaticResource InkBrush}" FontSize="14" MouseDoubleClick="Library_MouseDoubleClick">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="1">
                                <TextBlock Text="{Binding Title}"/>
                                <TextBlock Text="{Binding Detail}" FontSize="11" Foreground="{StaticResource MutedBrush}" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>
    </Grid>
</Window>
