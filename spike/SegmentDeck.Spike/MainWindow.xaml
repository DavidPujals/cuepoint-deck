<Window x:Class="SegmentDeck.Spike.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Segment Deck — Resolume spike (Stage 1)"
        Background="{StaticResource BgBrush}"
        MinWidth="1100" MinHeight="700"
        Width="1480" Height="920"
        Loaded="Window_Loaded" Closing="Window_Closing">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="8"/>
            <RowDefinition Height="230"/>
        </Grid.RowDefinitions>

        <!-- ===== connection bar ===== -->
        <Border Grid.Row="0" Style="{StaticResource Panel}">
            <StackPanel Orientation="Horizontal">
                <Ellipse x:Name="Light" Width="14" Height="14" Fill="{StaticResource DangerBrush}" Margin="0,0,10,0"/>
                <Label Content="Host"/>
                <TextBox x:Name="HostBox" Text="localhost" Width="160"/>
                <Label Content="Port" Margin="10,0,0,0"/>
                <TextBox x:Name="PortBox" Text="8080" Width="60"/>
                <Button x:Name="ConnectBtn" Content="Connect" Style="{StaticResource PrimaryButton}" Margin="10,0,0,0" MinWidth="100" Click="ConnectBtn_Click"/>
                <Button x:Name="DisconnectBtn" Content="Disconnect" Margin="6,0,0,0" MinWidth="100" IsEnabled="False" Click="DisconnectBtn_Click"/>
                <Button x:Name="RefreshBtn" Content="Re-read composition (REST)" Margin="6,0,0,0" IsEnabled="False" Click="RefreshBtn_Click"/>
                <Label Content="Song layer" Margin="16,0,0,0"/>
                <TextBox x:Name="SongLayerBox" Text="1" Width="40" TextAlignment="Center"/>
                <CheckBox x:Name="AutoWatchCheck" Content="Auto-watch the clip that connects on the song layer" IsChecked="True" Margin="10,0,0,0"/>
                <TextBlock x:Name="StatusText" Margin="16,0,0,0" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" Text="Not connected"/>
            </StackPanel>
        </Border>

        <!-- ===== main area ===== -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="2*" MinWidth="420"/>
            </Grid.ColumnDefinitions>

            <!-- composition grid -->
            <DockPanel Grid.Column="0">
                <TextBlock DockPanel.Dock="Top" Style="{StaticResource SectionLabel}" Margin="2,0,0,4"
                           Text="COMPOSITION  (select a row to target it with the tests on the right)"/>
                <DataGrid x:Name="ClipGrid" SelectionChanged="ClipGrid_SelectionChanged">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Layer" Binding="{Binding Layer}" Width="48"/>
                        <DataGridTextColumn Header="Col" Binding="{Binding Column}" Width="40"/>
                        <DataGridTextColumn Header="Clip name" Binding="{Binding Name}" Width="180"/>
                        <DataGridTextColumn Header="Connected" Binding="{Binding Connected}" Width="150"/>
                        <DataGridTextColumn Header="Duration" Binding="{Binding DurationText}" Width="80"/>
                        <DataGridTextColumn Header="fps" Binding="{Binding Fps, StringFormat={}{0:0.###}}" Width="52"/>
                        <DataGridTextColumn Header="Pos min" Binding="{Binding PosMin}" Width="60"/>
                        <DataGridTextColumn Header="Pos max" Binding="{Binding PosMax}" Width="90"/>
                        <DataGridTextColumn Header="Transport" Binding="{Binding TransportType}" Width="80"/>
                        <DataGridTextColumn Header="Exists" Binding="{Binding FileExists}" Width="52"/>
                        <DataGridTextColumn Header="Source file path" Binding="{Binding FilePath}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>

            <!-- right column -->
            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                <StackPanel>

                    <!-- LIVE -->
                    <Border Style="{StaticResource Panel}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionLabel}" Margin="0,0,0,4" Text="CONNECTED CLIP PER LAYER (live)"/>
                            <TextBlock x:Name="LiveText" Style="{StaticResource Mono}" Text="—" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <!-- POSITION -->
                    <Border Style="{StaticResource Panel}">
                        <StackPanel>
                            <DockPanel>
                                <Button DockPanel.Dock="Right" x:Name="WatchSelectedBtn" Content="Watch selected clip" MinHeight="28" FontSize="12" IsEnabled="False" Click="WatchSelectedBtn_Click"/>
                                <TextBlock Style="{StaticResource SectionLabel}" Margin="0,0,0,4" Text="POSITION STREAM"/>
                            </DockPanel>
                            <TextBlock x:Name="WatchedText" Text="Nothing watched yet" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"/>
                            <Grid Margin="0,6,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/>
                                </Grid.RowDefinitions>
                                <Label Grid.Row="0" Content="Raw value"/>
                                <TextBlock Grid.Row="0" Grid.Column="1" x:Name="PosRawText" Style="{StaticResource Mono}" Text="—"/>
                                <Label Grid.Row="1" Content="min / max"/>
                                <TextBlock Grid.Row="1" Grid.Column="1" x:Name="PosRangeText" Style="{StaticResource Mono}" Text="—"/>
                                <Label Grid.Row="2" Content="Units"/>
                                <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal">
                                    <ComboBox x:Name="UnitCombo" Width="130" SelectedIndex="0" SelectionChanged="UnitCombo_SelectionChanged">
                                        <ComboBoxItem Content="Auto-detect"/>
                                        <ComboBoxItem Content="Normalised 0..1"/>
                                        <ComboBoxItem Content="Seconds"/>
                                        <ComboBoxItem Content="Milliseconds"/>
                                        <ComboBoxItem Content="Raw (as ms)"/>
                                    </ComboBox>
                                    <TextBlock x:Name="UnitDeducedText" Margin="8,0,0,0" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}"/>
                                </StackPanel>
                                <Label Grid.Row="3" Content="As time"/>
                                <TextBlock Grid.Row="3" Grid.Column="1" x:Name="PosTimeText" FontFamily="Consolas" FontSize="26" FontWeight="Bold" Text="--:--.---"/>
                                <Label Grid.Row="4" Content="Update rate"/>
                                <TextBlock Grid.Row="4" Grid.Column="1" x:Name="RateText" Style="{StaticResource Mono}" Text="—"/>
                                <Label Grid.Row="5" Content="Speed / duration"/>
                                <TextBlock Grid.Row="5" Grid.Column="1" x:Name="SpeedText" Style="{StaticResource Mono}" Text="—"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- SEEK -->
                    <Border Style="{StaticResource Panel}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionLabel}" Margin="0,0,0,4" Text="SEEK THE WATCHED CLIP"/>
                            <StackPanel Orientation="Horizontal">
                                <Label Content="Time"/>
                                <TextBox x:Name="SeekTimeBox" Text="60" Width="90" ToolTip="Seconds, or mm:ss.fff" KeyDown="SeekTimeBox_KeyDown"/>
                                <Label Content="via" Margin="10,0,0,0"/>
                                <ComboBox x:Name="SeekViaCombo" Width="190" SelectedIndex="0">
                                    <ComboBoxItem Content="WS set /parameter/by-id"/>
                                    <ComboBoxItem Content="WS set logical path (fails)"/>
                                    <ComboBoxItem Content="REST PUT /parameter/by-id"/>
                                    <ComboBoxItem Content="REST PUT clip (partial)"/>
                                </ComboBox>
                                <Button x:Name="SeekBtn" Content="Seek" Style="{StaticResource GoButton}" Margin="10,0,0,0" MinWidth="80" IsEnabled="False" Click="SeekBtn_Click"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                <Label Content="Confirm within"/>
                                <TextBox x:Name="ToleranceBox" Text="1" Width="40" TextAlignment="Center"/>
                                <Label Content="frame(s) of target" Margin="4,0,0,0"/>
                            </StackPanel>
                            <TextBlock x:Name="SeekResultText" Margin="0,6,0,0" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"
                                       Text="Each seek logs the delay until a position update lands within tolerance."/>
                        </StackPanel>
                    </Border>

                    <!-- CONNECT + SEEK -->
                    <Border Style="{StaticResource Panel}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionLabel}" Margin="0,0,0,4" Text="CONNECT-AND-SEEK ON THE SELECTED CLIP"/>
                            <TextBlock x:Name="TargetText" Text="No clip selected" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"/>
                            <TextBlock x:Name="TargetSettingsText" Style="{StaticResource Mono}" FontSize="11" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,2,0,6"/>
                            <StackPanel Orientation="Horizontal">
                                <Label Content="Seek to"/>
                                <TextBox x:Name="CsTimeBox" Text="60" Width="70"/>
                                <Label Content="delay (ms)" Margin="10,0,0,0"/>
                                <TextBox x:Name="CsDelayBox" Text="100" Width="60"/>
                                <CheckBox x:Name="CsRestConnectCheck" Content="connect via REST" Margin="12,0,0,0"/>
                                <CheckBox x:Name="CsRestSeekCheck" Content="seek via REST" Margin="8,0,0,0"/>
                            </StackPanel>
                            <UniformGrid Columns="2" Margin="0,6,0,0">
                                <Button x:Name="CsAButton" Content="A: connect → seek at once" Margin="0,0,4,4" IsEnabled="False" Click="CsA_Click"/>
                                <Button x:Name="CsBButton" Content="B: seek → connect" Margin="0,0,0,4" IsEnabled="False" Click="CsB_Click"/>
                                <Button x:Name="CsCButton" Content="C: connect → wait → seek" Margin="0,0,4,4" IsEnabled="False" Click="CsC_Click"/>
                                <Button x:Name="CsGButton" Content="G: connect → see reset → seek" Margin="0,0,0,4" IsEnabled="False" Click="CsG_Click"/>
                                <Button x:Name="CsFButton" Content="F: in-point → connect → restore" Margin="0,0,4,4" IsEnabled="False" Click="CsF_Click"/>
                                <Button x:Name="CsConnectOnlyButton" Content="Connect only" Margin="0,0,0,4" IsEnabled="False" Click="CsConnectOnly_Click"/>
                                <Button x:Name="CsClearLayerButton" Content="Clear layer (stops output on it!)" Style="{StaticResource DangerButton}" Margin="0,0,4,0" IsEnabled="False" Click="CsClearLayer_Click"/>
                            </UniformGrid>
                            <TextBlock Margin="0,6,0,0" FontSize="11" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"
                                       Text="Watch the Resolume output while running these. Note which order lands on the right frame without flashing the clip's first frame."/>
                        </StackPanel>
                    </Border>

                    <!-- RAW -->
                    <Border Style="{StaticResource Panel}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionLabel}" Margin="0,0,0,4" Text="RAW"/>
                            <DockPanel>
                                <Button DockPanel.Dock="Right" x:Name="RawSendBtn" Content="Send WS" Margin="6,0,0,0" MinWidth="80" IsEnabled="False" Click="RawSendBtn_Click"/>
                                <TextBox x:Name="RawBox" FontFamily="Consolas" Text='{}{"action":"get","parameter":"/composition/layers/1/clips/1/transport/position"}' KeyDown="RawBox_KeyDown"/>
                            </DockPanel>
                            <DockPanel Margin="0,6,0,0">
                                <Button DockPanel.Dock="Right" x:Name="RestGetBtn" Content="REST GET" Margin="6,0,0,0" MinWidth="80" IsEnabled="False" Click="RestGetBtn_Click"/>
                                <TextBox x:Name="RestPathBox" FontFamily="Consolas" Text="/composition/layers/1/clips/1" KeyDown="RestPathBox_KeyDown"/>
                            </DockPanel>
                        </StackPanel>
                    </Border>

                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- ===== log ===== -->
        <DockPanel Grid.Row="3">
            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,4">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <CheckBox x:Name="LogEveryPosCheck" Content="Log every position update"/>
                    <CheckBox x:Name="LogAllRawCheck" Content="Log every raw message" Margin="12,0,0,0"/>
                    <Button Content="Clear" MinHeight="26" FontSize="12" Margin="12,0,0,0" Click="ClearLog_Click"/>
                    <Button Content="Open log folder" MinHeight="26" FontSize="12" Margin="6,0,0,0" Click="OpenLogs_Click"/>
                </StackPanel>
                <TextBlock Style="{StaticResource SectionLabel}" Margin="2,0,0,0" Text="LOG  (also written to %AppData%\SegmentDeck\logs)"/>
            </DockPanel>
            <TextBox x:Name="LogBox" IsReadOnly="True" FontFamily="Consolas" FontSize="12" TextWrapping="NoWrap"
                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" AcceptsReturn="True"/>
        </DockPanel>
    </Grid>
</Window>
